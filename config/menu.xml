<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Entorno de Desarrollo">
    <separator label="Aplicaciones" />
    <item label="🚀 Visual Studio Code">
      <action name="Execute">
        <command>code-oss --no-sandbox --disable-gpu --password-store=basic</command>
      </action>
    </item>
    <item label="🌐 Zen Browser">
      <action name="Execute">
        <command>zen-browser</command>
      </action>
    </item>
    <separator label="Sesión y Sistema" />
    <item label="🔄 Recargar Interfaz Openbox">
      <action name="Restart" />
    </item>
    <item label="💾 Sincronización Segura">
      <action name="Execute">
        <command>sync-vscode</command>
      </action>
    </item>
    <item label="❌ Cerrar VS Code y Entorno">
      <action name="Execute">
        <command>stop-vscode</command>
      </action>
    </item>
  </menu>
</openbox_menu>

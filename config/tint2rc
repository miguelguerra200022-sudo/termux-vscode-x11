# ==============================================================================
# tint2rc - Barra de Tareas Estilo Ubuntu (Yaru Dark) UI/UX Táctil para Termux-X11
# ==============================================================================
# Características:
#  - Altura táctil optimizada para pantallas móviles FHD+/QHD+ (46px).
#  - Iconos nítidos de 30px para VS Code, Zen Browser y selector Táctil/Cursor.
#  - Estilo Ubuntu: Fondo grafito oscuro (#181818) con indicador naranja (#e95420).
#  - Multitarea fluida: Botones anchos con fuentes nítidas Sans Bold 10.
#  - Conmutador táctil directo en la barra (Trackpad <-> Direct Touch).
# ==============================================================================

# Background 1: Panel principal (Fondo oscuro elegante estilo Ubuntu Yaru)
rounded = 0
border_width = 1
border_sides = T
background_color = #181818 100
border_color = #2c2c2c 100
background_color_hover = #181818 100
border_color_hover = #2c2c2c 100
background_color_pressed = #181818 100
border_color_pressed = #2c2c2c 100

# Background 2: Ventana inactiva
rounded = 4
border_width = 1
border_sides = TBLR
background_color = #242424 100
border_color = #333333 100
background_color_hover = #363636 100
border_color_hover = #484848 100
background_color_pressed = #1c1c1c 100
border_color_pressed = #484848 100

# Background 3: Ventana activa (Línea naranja inferior estilo Ubuntu #e95420)
rounded = 4
border_width = 3
border_sides = B
background_color = #323232 100
border_color = #e95420 100
background_color_hover = #3a3a3a 100
border_color_hover = #ff6e38 100
background_color_pressed = #262626 100
border_color_pressed = #e95420 100

# Background 4: Ventana de alerta / urgente
rounded = 4
border_width = 3
border_sides = B
background_color = #e95420 100
border_color = #ffffff 100
background_color_hover = #ff6e38 100
border_color_hover = #ffffff 100
background_color_pressed = #c43c08 100
border_color_pressed = #ffffff 100

# Background 5: Tooltips informativos
rounded = 4
border_width = 1
border_sides = TBLR
background_color = #222222 100
border_color = #444444 100
background_color_hover = #222222 100
border_color_hover = #444444 100
background_color_pressed = #222222 100
border_color_pressed = #444444 100

# Background 6: Reloj
rounded = 4
border_width = 0
border_sides = none
background_color = #222222 100
border_color = #000000 0
background_color_hover = #2d2d2d 100
border_color_hover = #000000 0
background_color_pressed = #181818 100
border_color_pressed = #000000 0

# Background 7: Ventana minimizada (iconificada)
rounded = 4
border_width = 1
border_sides = TBLR
background_color = #1c1c1c 100
border_color = #2a2a2a 100
background_color_hover = #303030 100
border_color_hover = #3d3d3d 100
background_color_pressed = #151515 100
border_color_pressed = #3d3d3d 100

# ------------------------------------------------------------------------------
# Panel Principal
# ------------------------------------------------------------------------------
panel_items = LTSC
panel_size = 100% 46
panel_margin = 0 0
panel_padding = 6 2 6
panel_background_id = 1
wm_menu = 0
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = normal
panel_monitor = all
panel_shrink = 0
autohide = 0
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 1
mouse_effects = 1
font_shadow = 0

# ------------------------------------------------------------------------------
# Lanzadores Fijos de Aplicaciones (Launcher)
# ------------------------------------------------------------------------------
launcher_padding = 6 2 8
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 30
launcher_icon_asb = 100 0 0
launcher_icon_theme_override = 0
startup_notifications = 0
launcher_tooltip = 1
launcher_item_app = /data/data/com.termux/files/usr/share/applications/code-oss.desktop
launcher_item_app = /data/data/com.termux/files/usr/share/applications/zen-browser.desktop
launcher_item_app = /data/data/com.termux/files/usr/share/applications/touch-toggle.desktop

# ------------------------------------------------------------------------------
# Barra de Tareas (Taskbar)
# ------------------------------------------------------------------------------
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 0 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_hide_different_desktop = 0
taskbar_always_show_all_desktop_tasks = 1
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left

# ------------------------------------------------------------------------------
# Tareas individuales (Botones de cada ventana)
# ------------------------------------------------------------------------------
task_text = 1
task_icon = 1
task_centered = 0
urgent_nb_of_blink = 100000
task_maximum_size = 240 38
task_padding = 8 3 6
task_font = Sans Bold 10
task_tooltip = 1
task_thumbnail = 0
task_font_color = #b0b0b0 100
task_active_font_color = #ffffff 100
task_urgent_font_color = #ffffff 100
task_iconified_font_color = #777777 100
task_icon_asb = 100 0 0
task_active_icon_asb = 100 0 0
task_urgent_icon_asb = 100 0 0
task_iconified_icon_asb = 60 -30 -10
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 4
task_iconified_background_id = 7

# Acciones táctiles y de ratón intuitivas
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = maximize_restore
mouse_scroll_up = prev_task
mouse_scroll_down = next_task

# ------------------------------------------------------------------------------
# Bandeja del Sistema (Systray)
# ------------------------------------------------------------------------------
systray_padding = 6 2 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 24
systray_icon_asb = 100 0 0
systray_monitor = 1
systray_name_filter = 

# ------------------------------------------------------------------------------
# Reloj del Sistema
# ------------------------------------------------------------------------------
time1_format = %H:%M
time2_format = 
time1_font = Sans Bold 10
time2_font = Sans 8
clock_font_color = #e0e0e0 100
clock_padding = 10 2
clock_background_id = 6
clock_tooltip = %A, %d de %B de %Y
clock_tooltip_timezone = 
clock_lclick_command = 
clock_rclick_command = 
clock_mclick_command = 
clock_uwheel_command = 
clock_dwheel_command = 

# ------------------------------------------------------------------------------
# Tooltips informativos
# ------------------------------------------------------------------------------
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 8 5
tooltip_background_id = 5
tooltip_font_color = #ffffff 100
tooltip_font = Sans 9

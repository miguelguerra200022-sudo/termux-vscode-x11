#!/data/data/com.termux/files/usr/bin/bash
set -e

# ==============================================================================
# system-compiler: Motor de Compilación Nativa ELF para Scripts de Code Stack Sh
# ==============================================================================
# - Transforma scripts de Shell y Python en binarios ELF nativos ARM64 despojados (stripped).
# - Hace que los archivos en el celular cliente sean completamente ilegibles (código máquina).
# - Cero pérdida de rendimiento; se ejecuta a velocidad nativa del CPU sin consumo extra de batería.
# - Mantiene el código fuente legible y limpio en GitHub para el desarrollador.
# ==============================================================================

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
GRAY='\033[0;90m'
NC='\033[0m'

command -v shc >/dev/null 2>&1 || pkg install -y shc clang >/dev/null 2>&1 || true
command -v clang >/dev/null 2>&1 || pkg install -y clang >/dev/null 2>&1 || true

TMP_BUILD="${TMPDIR:-/data/data/com.termux/files/usr/tmp}/sys_compiler_$$"
mkdir -p "$TMP_BUILD"
trap 'rm -rf "$TMP_BUILD"' EXIT

compile_script() {
    local src="$1"
    local dest="${2:-$src}"
    local name=$(basename "$src")

    [ -f "$src" ] || return 1
    local first_line=$(head -n 1 "$src" 2>/dev/null || true)
    local is_elf=0
    if head -c 4 "$src" 2>/dev/null | grep -q "ELF"; then
        is_elf=1
    fi

    if [ "$is_elf" -eq 1 ]; then
        echo -e " ${GRAY}• [ELF Ya Compilado]${NC} ${name}"
        return 0
    fi

    echo -ne " ${CYAN}⚡ Compilando nativamente:${NC} ${BOLD}${name}${NC}... "

    local work_sh="$TMP_BUILD/${name}.sh"
    local work_bin="$TMP_BUILD/${name}.bin"

    if [[ "$first_line" == *"python"* ]] || [[ "$first_line" == *"python3"* ]]; then
        cat << EOF_PYWRAP > "$work_sh"
#!/data/data/com.termux/files/usr/bin/bash
ulimit -c 0 2>/dev/null || true
PAYLOAD_B64='__PY_PAYLOAD_PLACEHOLDER__'
exec /data/data/com.termux/files/usr/bin/python3 -c "import sys, base64; sys.argv[0]='$name'; exec(base64.b64decode('$PAYLOAD_B64').decode('utf-8'))" "\$@"
EOF_PYWRAP
        local py_b64=$(base64 -w 0 < "$src")
        python3 -c "
with open('$work_sh', 'r') as f:
    c = f.read()
c = c.replace('__PY_PAYLOAD_PLACEHOLDER__', '''$py_b64''')
with open('$work_sh', 'w') as f:
    f.write(c)
" 2>/dev/null || sed -i "s|__PY_PAYLOAD_PLACEHOLDER__|$py_b64|g" "$work_sh"
    else
        cp -f "$src" "$work_sh"
    fi

    chmod +x "$work_sh"

    # Compilar con SHC a código C y compilar a ELF ARM64 con clang
    if shc -r -f "$work_sh" -o "$work_bin" >/dev/null 2>&1; then
        strip "$work_bin" 2>/dev/null || true
        cp -f "$work_bin" "$dest"
        chmod 755 "$dest"
        echo -e "${GREEN}[✓ ELF OK]${NC}"
    else
        echo -e "${RED}[!] Falló compilación${NC}"
        return 1
    fi
}

CODE_STACK_TARGETS=(
    "github-auth-broker"
    "cloud-sentinel"
    "start-vscode"
    "encender"
    "vscode"
    "flota"
    "sync-vscode"
    "restore-vscode"
    "code-stack-ascii"
    "dev-info"
    "guia"
    "orientation-sentinel"
    "termux-runner"
    "gitops-sync"
    "fix-phantom-killer"
    "new-project"
    "share-port"
    "stop-vscode"
    "apagar"
    "switch-identity"
    "vault-logs"
    "programas"
    "desinstalar"
    "desinstalar-vscode"
    "fetch-app-icon"
    "integrity-guard"
    "integrity-watchdog"
    "set-marketplace"
    "setup-swap"
    "start-vscode-web"
    "toggle-touch-mode"
    "watcher-sync"
)

check_all() {
    echo -e "${BLUE}======================================================${NC}"
    echo -e "${GREEN}  🔍 ESTADO DE COMPILACIÓN NATIVA (CODE STACK SH)${NC}"
    echo -e "${BLUE}======================================================${NC}"
    local count_elf=0
    local count_src=0

    for item in "${CODE_STACK_TARGETS[@]}"; do
        local f="$PREFIX/bin/$item"
        [ -f "$f" ] || continue
        if head -c 4 "$f" 2>/dev/null | grep -q "ELF"; then
            count_elf=$((count_elf + 1))
            echo -e " ${GREEN}• [ELF Nativo]:${NC} $item"
        else
            count_src=$((count_src + 1))
            echo -e " ${YELLOW}• [Texto Plano]:${NC} $item"
        fi
    done
    echo ""
    echo -e "📊 ${BOLD}Resumen:${NC} ${GREEN}${count_elf} binarios ELF nativos${NC} | ${YELLOW}${count_src} scripts en texto plano${NC}."
    echo ""
}

compile_all_code_stack() {
    echo -e "${BLUE}======================================================${NC}"
    echo -e "${GREEN}  🚀 COMPILADOR NATIVO • BLINDAJE DE CÓDIGO FUENTE${NC}"
    echo -e "${CYAN}     «Generando binarios ELF ARM64 ilegibles y despojados»${NC}"
    echo -e "${BLUE}======================================================${NC}"
    echo ""

    for item in "${CODE_STACK_TARGETS[@]}"; do
        if [ -f "$PREFIX/bin/$item" ]; then
            compile_script "$PREFIX/bin/$item" "$PREFIX/bin/$item" || true
        fi
    done

    echo ""
    echo -e "${GREEN}[✓] ¡Compilación nativa completada con éxito!${NC}"
    echo -e "${GRAY}    Todos los binarios en $PREFIX/bin ahora son ejecutables ELF nativos.${NC}"
    echo -e "${GRAY}    Nadie en el celular cliente puede ver ni editar el código fuente.${NC}"
}

ACTION="${1:---all}"

case "$ACTION" in
    --check|-c)
        check_all
        ;;
    --bin|-b)
        if [ -z "$2" ]; then
            echo "Uso: system-compiler --bin <nombre_en_prefix_bin>"
            exit 1
        fi
        compile_script "$PREFIX/bin/$2" "$PREFIX/bin/$2"
        ;;
    --all|-a)
        compile_all_code_stack
        ;;
    *)
        compile_all_code_stack
        ;;
esac

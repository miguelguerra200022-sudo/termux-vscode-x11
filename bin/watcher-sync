#!/data/data/com.termux/files/usr/bin/bash
set -e

# ==============================================================================
# watcher-sync: Demonio Autónomo de Integridad, Anti-Tamper y Sincronización 24/7
# ==============================================================================
# - Vigilancia en tiempo real e inmutable del código fuente y configuraciones.
# - Detección automática y purga inmediata (auto-healing) de alteraciones externas
#   cuando VS Code no está en ejecución.
# - Auto-defensa y auto-reparación del propio demonio, centinelas y claves Ed25519.
# - Sincronización silenciosa con Debounce Inteligente y firmas digitales.
# ==============================================================================

PIDFILE="${TMPDIR:-/data/data/com.termux/files/usr/tmp}/watcher-sync.pid"
GOLDEN_DIR="$HOME/.config/termux-vscode/.golden"

# 1. Evitar múltiples instancias del demonio
if [ -f "$PIDFILE" ]; then
    OLD_PID=$(cat "$PIDFILE" 2>/dev/null || true)
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        exit 0
    fi
fi
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE" 2>/dev/null; exit 0' SIGTERM SIGINT SIGHUP EXIT

# 2. Localizar dinámicamente el repositorio en cualquier dispositivo
REPO_DIR=""
CONFIG_FILE="$HOME/.config/termux-vscode/repo_path"
[ -f "$CONFIG_FILE" ] && REPO_DIR=$(cat "$CONFIG_FILE" 2>/dev/null || true)
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    SCRIPT_PARENT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
    [ -d "$SCRIPT_PARENT/.git" ] && REPO_DIR="$SCRIPT_PARENT"
fi
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    for root in "$HOME" "${STORAGE_ROOT:-/storage/emulated/0}" "/sdcard" "/var/mobile"; do
        [ -d "$root" ] || continue
        found=$(find "$root" -maxdepth 4 -type d -name "termux-vscode-x11" 2>/dev/null | head -n 1)
        if [ -n "$found" ] && [ -d "$found/.git" ]; then
            REPO_DIR="$found"
            mkdir -p "$HOME/.config/termux-vscode"
            echo "$REPO_DIR" > "$CONFIG_FILE" 2>/dev/null || true
            break
        fi
    done
fi

if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    exit 0
fi

# 3. Inicializar Bóveda Dorada (Golden Vault) para Auto-Protección
init_golden_vault() {
    mkdir -p "$GOLDEN_DIR" "$HOME/.config/git" "$HOME/.ssh"
    chmod 700 "$HOME/.config/termux-vscode" "$GOLDEN_DIR" 2>/dev/null || true

    # Respaldar binarios de defensa originales en bóveda dorada protegida
    for bin_name in "watcher-sync" "integrity-watchdog" "integrity-guard" "encender" "apagar" "orientation-sentinel" "start-vscode" "stop-vscode" "switch-identity" "cloud-sentinel" "flota" "termux-runner" "vault-logs" "gitops-sync"; do
        if [ -f "$PREFIX/bin/$bin_name" ] && [ ! -f "$GOLDEN_DIR/$bin_name" ]; then
            cp "$PREFIX/bin/$bin_name" "$GOLDEN_DIR/$bin_name" 2>/dev/null || true
            chmod 500 "$GOLDEN_DIR/$bin_name" 2>/dev/null || true
        elif [ -f "$REPO_DIR/bin/$bin_name" ] && [ ! -f "$GOLDEN_DIR/$bin_name" ]; then
            cp "$REPO_DIR/bin/$bin_name" "$GOLDEN_DIR/$bin_name" 2>/dev/null || true
            chmod 500 "$GOLDEN_DIR/$bin_name" 2>/dev/null || true
        fi
    done

    # Respaldar claves y configuraciones criptográficas
    if [ -f "$HOME/.ssh/id_ed25519" ] && [ ! -f "$GOLDEN_DIR/id_ed25519" ]; then
        cp "$HOME/.ssh/id_ed25519" "$GOLDEN_DIR/id_ed25519" 2>/dev/null || true
        cp "$HOME/.ssh/id_ed25519.pub" "$GOLDEN_DIR/id_ed25519.pub" 2>/dev/null || true
        chmod 400 "$GOLDEN_DIR/id_ed25519" 2>/dev/null || true
    fi
    if [ -f "$HOME/.config/git/allowed_signers" ] && [ ! -f "$GOLDEN_DIR/allowed_signers" ]; then
        cp "$HOME/.config/git/allowed_signers" "$GOLDEN_DIR/allowed_signers" 2>/dev/null || true
        chmod 400 "$GOLDEN_DIR/allowed_signers" 2>/dev/null || true
    fi
    AUTH_ENC="$HOME/.config/termux-vscode/.auth_token.enc"
    if [ -f "$AUTH_ENC" ] && [ ! -f "$GOLDEN_DIR/.auth_token.enc" ]; then
        cp "$AUTH_ENC" "$GOLDEN_DIR/.auth_token.enc" 2>/dev/null || true
        chmod 400 "$GOLDEN_DIR/.auth_token.enc" 2>/dev/null || true
    fi

    # Blindar permisos en ejecución (solo lectura/ejecución para el propietario)
    chmod 500 "$PREFIX/bin/watcher-sync" "$PREFIX/bin/integrity-guard" "$PREFIX/bin/integrity-watchdog" 2>/dev/null || true
    chmod 400 "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ed25519.pub" "$HOME/.config/git/allowed_signers" 2>/dev/null || true
}

init_golden_vault

# 4. Auto-Auditoría y Auto-Reparación de la propia infraestructura de defensa
self_audit_and_repair() {
    # 4.1 Verificar y reparar integridad de los binarios de defensa
    for bin_name in "watcher-sync" "integrity-watchdog" "integrity-guard"; do
        if [ ! -s "$PREFIX/bin/$bin_name" ] && [ -f "$GOLDEN_DIR/$bin_name" ]; then
            cp "$GOLDEN_DIR/$bin_name" "$PREFIX/bin/$bin_name" 2>/dev/null || true
            chmod 500 "$PREFIX/bin/$bin_name" 2>/dev/null || true
        fi
    done

    # 4.2 Verificar y reparar claves Ed25519 y allowed_signers
    if [ ! -s "$HOME/.ssh/id_ed25519" ] && [ -f "$GOLDEN_DIR/id_ed25519" ]; then
        mkdir -p "$HOME/.ssh"
        cp "$GOLDEN_DIR/id_ed25519" "$HOME/.ssh/id_ed25519" 2>/dev/null || true
        cp "$GOLDEN_DIR/id_ed25519.pub" "$HOME/.ssh/id_ed25519.pub" 2>/dev/null || true
        chmod 400 "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ed25519.pub" 2>/dev/null || true
    fi
    if [ ! -s "$HOME/.config/git/allowed_signers" ] && [ -f "$GOLDEN_DIR/allowed_signers" ]; then
        mkdir -p "$HOME/.config/git"
        cp "$GOLDEN_DIR/allowed_signers" "$HOME/.config/git/allowed_signers" 2>/dev/null || true
        chmod 400 "$HOME/.config/git/allowed_signers" 2>/dev/null || true
    fi

    # 4.3 Verificar y reparar token de autenticación cifrado
    if [ ! -s "$AUTH_ENC" ] && [ -f "$GOLDEN_DIR/.auth_token.enc" ]; then
        mkdir -p "$HOME/.config/termux-vscode"
        cp "$GOLDEN_DIR/.auth_token.enc" "$AUTH_ENC" 2>/dev/null || true
        chmod 400 "$AUTH_ENC" 2>/dev/null || true
    fi

    # 4.4 Verificar centinela supervisor mutuo (integrity-watchdog)
    if ! pgrep -f "integrity-watchdog" >/dev/null 2>&1; then
        if command -v integrity-watchdog >/dev/null 2>&1; then
            setsid -f integrity-watchdog >/dev/null 2>&1 || true
        elif [ -f "$GOLDEN_DIR/integrity-watchdog" ]; then
            cp "$GOLDEN_DIR/integrity-watchdog" "$PREFIX/bin/integrity-watchdog" 2>/dev/null || true
            chmod 500 "$PREFIX/bin/integrity-watchdog" 2>/dev/null || true
            setsid -f "$PREFIX/bin/integrity-watchdog" >/dev/null 2>&1 || true
        fi
    fi

    # 4.5 Garantizar persistencia del gancho supervisor en ~/.bashrc
    if ! grep -q "watcher-sync" "$HOME/.bashrc" 2>/dev/null; then
        cat << 'BASHRC_HOOK' >> "$HOME/.bashrc"

# Demonio Autónomo de Integridad y Sincronización en Segundo Plano (Watchdog)
if command -v watcher-sync >/dev/null 2>&1; then
    if ! pgrep -f "watcher-sync" >/dev/null 2>&1; then
        setsid -f watcher-sync >/dev/null 2>&1 || true
    fi
fi
export PROMPT_COMMAND="pgrep -f watcher-sync >/dev/null 2>&1 || ( setsid -f watcher-sync >/dev/null 2>&1 || true ); ${PROMPT_COMMAND:-}"
BASHRC_HOOK
    fi

    # 4.6 Asegurar configuración de firma criptográfica en Git
    if [ "$(git config --global commit.gpgsign 2>/dev/null || true)" != "true" ]; then
        git config --global user.signingkey "$HOME/.ssh/id_ed25519.pub" 2>/dev/null || true
        git config --global gpg.format ssh 2>/dev/null || true
        git config --global commit.gpgsign true 2>/dev/null || true
        git config --global gpg.ssh.allowedsignersfile "$HOME/.config/git/allowed_signers" 2>/dev/null || true
    fi

    # 4.7 Supervisar demonio interactivo de Telegram (cloud-sentinel daemon)
    if ! pgrep -f "cloud-sentinel daemon" >/dev/null 2>&1; then
        if command -v cloud-sentinel >/dev/null 2>&1; then
            setsid -f cloud-sentinel daemon >/dev/null 2>&1 || true
        fi
    fi
}

# 5. Detección y Auto-Recuperación de Alteraciones No Autorizadas (Anti-Tamper)
check_and_heal_tamper() {
    # No interferir si hay una sincronización o mantenimiento autorizado en progreso
    if [ -f "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/.maintenance" ] || pgrep -f "sync-vscode" >/dev/null 2>&1; then
        return 0
    fi
    # Solo actuar cuando VS Code NO está en ejecución (código en reposo)
    if ! pgrep -f "code-oss" >/dev/null 2>&1; then
        if command -v integrity-guard >/dev/null 2>&1; then
            # Verificar integridad de forma silenciosa
            if ! integrity-guard check "$REPO_DIR" >/dev/null 2>&1; then
                # Alteración externa detectada -> Ejecutar auto-recuperación y purga instantánea
                integrity-guard heal "$REPO_DIR" >/dev/null 2>&1 || true
            fi
        fi
    fi
}

# 5.1 Sincronización Incremental por Deltas hacia Cloudflare Edge Gateway (Bytes en tiempo real)
sync_deltas_to_gateway() {
    local target_seal="$1"
    local gw_url=""
    [ -f "$HOME/.config/termux-vscode/gateway_url" ] && gw_url=$(cat "$HOME/.config/termux-vscode/gateway_url" 2>/dev/null | tr -d '[:space:]')
    [ -n "$GATEWAY_URL" ] && gw_url="$GATEWAY_URL"
    [ -z "$gw_url" ] && return 0

    python3 -c '
import os, sys, json, hashlib, urllib.request, subprocess

seal = sys.argv[1]
gw = sys.argv[2]
watch_dirs = [
    os.path.expanduser("~/.config/Code - OSS/User"),
    os.path.expanduser("~/.config/zen"),
    os.path.expanduser("~/.config/termux-software-center")
]
hash_cache_file = os.path.expanduser("~/.config/termux-vscode/.file_hashes.json")
hashes = {}
if os.path.isfile(hash_cache_file):
    try:
        with open(hash_cache_file, "r") as f:
            hashes = json.load(f)
    except Exception:
        pass

changed_files = []
for wdir in watch_dirs:
    if not os.path.isdir(wdir):
        continue
    for root, _, files in os.walk(wdir):
        for fname in files:
            if any(x in fname for x in [".tmp", ".log", ".sock", "lock", "Crash Reports", "minidumps", "cache2"]):
                continue
            fpath = os.path.join(root, fname)
            try:
                st = os.stat(fpath)
                if st.st_size > 5 * 1024 * 1024:
                    continue
                with open(fpath, "rb") as f:
                    h = hashlib.sha256(f.read()).hexdigest()
                rel = os.path.relpath(fpath, os.path.expanduser("~/.config"))
                if hashes.get(rel) != h:
                    hashes[rel] = h
                    changed_files.append((fpath, rel, h))
            except Exception:
                continue

if not changed_files:
    sys.exit(0)

try:
    pass_key = subprocess.check_output(["github-auth-broker", "session-key", seal], stderr=subprocess.DEVNULL).decode().strip()
except Exception:
    pass_key = "vault_key"

for fpath, rel, h in changed_files[:10]:
    try:
        env = os.environ.copy()
        env["PASS_KEY"] = pass_key
        cmd = ["openssl", "enc", "-aes-256-cbc", "-a", "-A", "-salt", "-pbkdf2", "-iter", "10000", "-pass", "env:PASS_KEY", "-in", fpath]
        enc_payload = subprocess.check_output(cmd, env=env, stderr=subprocess.DEVNULL).decode().strip()
        
        req_data = json.dumps({
            "seal": seal,
            "file_rel": rel,
            "file_hash": h,
            "delta_enc": enc_payload
        }).encode()
        
        req = urllib.request.Request(f"{gw}/api/v1/vault/sync-delta", data=req_data, headers={"Content-Type": "application/json", "X-Device-Seal": seal})
        with urllib.request.urlopen(req, timeout=3) as resp:
            pass
    except Exception:
        continue

os.makedirs(os.path.dirname(hash_cache_file), exist_ok=True)
try:
    with open(hash_cache_file, "w") as f:
        json.dump(hashes, f)
except Exception:
    pass
' "$target_seal" "$gw_url" 2>/dev/null || true
}

# 6. Función de Sincronización, Firma Criptográfica y Subida a GitHub
do_sync() {
    # 6.1 Limpiar posibles bloqueos huérfanos de Git si hubo un cierre forzado
    if [ -f "$REPO_DIR/.git/index.lock" ]; then
        if ! pgrep -x "git" >/dev/null 2>&1; then
            rm -f "$REPO_DIR/.git/index.lock" 2>/dev/null || true
        fi
    fi

    # 6.2 Asegurar carpetas en el repositorio
    mkdir -p "$REPO_DIR/credenciales" "$REPO_DIR/config" "$REPO_DIR/bin"

    # 6.3 Sincronizar Bóveda Cifrada de la Identidad Activa (Zero Texto Plano)
    ACTIVE_FILE="$HOME/.config/termux-vscode/active_identity"
    ACTIVE_SEAL="ums9230-sp_6300-3724801c"
    [ -f "$ACTIVE_FILE" ] && ACTIVE_SEAL=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "$ACTIVE_SEAL")

    if [ -d "$REPO_DIR/credenciales/$ACTIVE_SEAL" ]; then
        VAULT_DIR="$REPO_DIR/credenciales/$ACTIVE_SEAL"
    else
        MATCH=$(find "$REPO_DIR/credenciales" -maxdepth 1 -type d -name "*${ACTIVE_SEAL}" 2>/dev/null | head -n 1)
        if [ -n "$MATCH" ]; then
            VAULT_DIR="$MATCH"
        else
            VAULT_DIR="$REPO_DIR/credenciales/$ACTIVE_SEAL"
            mkdir -p "$VAULT_DIR"
        fi
    fi
    TARGET_SEAL=$(basename "$VAULT_DIR")

    # 6.3 Sincronización Incremental por Deltas hacia Cloudflare Edge Gateway (en Bytes)
    sync_deltas_to_gateway "$TARGET_SEAL"

    # Respaldo local de seguridad en disco
    if [ -d "$HOME/.config/Code - OSS/User" ] || [ -d "$HOME/.config/zen" ]; then
        SESSION_KEY=$(github-auth-broker session-key "$TARGET_SEAL" 2>/dev/null || true)
        tar -czf - \
            --exclude="cache2" \
            --exclude="startupCache" \
            --exclude="lock" \
            --exclude=".parentlock" \
            --exclude="Crash Reports" \
            --exclude="minidumps" \
            --exclude="*.tmp" \
            --exclude="*.log" \
            --exclude="*.sock" \
            -C "$HOME/.config" "Code - OSS/User" "zen" 2>/dev/null | \
            PASS_KEY="$SESSION_KEY" openssl enc -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass env:PASS_KEY -out "$VAULT_DIR/vault.enc" 2>/dev/null || true
        unset SESSION_KEY
    fi

    # 6.4 Sincronizar configuraciones visuales locales
    [ -f "$HOME/.config/openbox/rc.xml" ] && cp "$HOME/.config/openbox/rc.xml" "$REPO_DIR/config/rc.xml" 2>/dev/null || true
    [ -f "$HOME/.config/openbox/menu.xml" ] && cp "$HOME/.config/openbox/menu.xml" "$REPO_DIR/config/menu.xml" 2>/dev/null || true
    [ -f "$HOME/.config/tint2/tint2rc" ] && cp "$HOME/.config/tint2/tint2rc" "$REPO_DIR/config/tint2rc" 2>/dev/null || true
    [ -f "$HOME/.config/tint2/tint2rc_vertical" ] && cp "$HOME/.config/tint2/tint2rc_vertical" "$REPO_DIR/config/tint2rc_vertical" 2>/dev/null || true
    [ -f "$HOME/.config/tint2/tint2rc_horizontal" ] && cp "$HOME/.config/tint2/tint2rc_horizontal" "$REPO_DIR/config/tint2rc_horizontal" 2>/dev/null || true
    [ -f "$HOME/.config/Code - OSS/User/settings.json" ] && cp "$HOME/.config/Code - OSS/User/settings.json" "$REPO_DIR/config/settings.json" 2>/dev/null || true

    # 6.5 Actualizar firma de integridad antes de registrar en Git
    if command -v integrity-guard >/dev/null 2>&1; then
        integrity-guard sign "$REPO_DIR" >/dev/null 2>&1 || true
    fi

    # 6.6 Regla de Oro: Solo el Celular Líder puede hacer commits/push de código a GitHub
    # Los celulares Workers NO tocan GitHub (cero colisiones y cero llamadas de fondo)
    LOCAL_SEAL=$(cat "$HOME/.config/termux-vscode/.device_hw_seal" 2>/dev/null || github-auth-broker seal 2>/dev/null || echo "")
    if [ "$LOCAL_SEAL" = "ums9230-sp_6300-3724801c" ]; then
        cd "$REPO_DIR"
        CHANGES=$(git status --porcelain 2>/dev/null || true)
        UNPUSHED=$(git log origin/main..HEAD --oneline 2>/dev/null || true)

        if [ -n "$CHANGES" ]; then
            git add -A 2>/dev/null || true
            git commit -S -m "sync: cambios en tiempo real ($(date '+%Y-%m-%d %H:%M:%S'))" >/dev/null 2>&1 || \
            git commit -m "sync: cambios en tiempo real ($(date '+%Y-%m-%d %H:%M:%S'))" >/dev/null 2>&1 || true
            UNPUSHED="1"
        fi

        if [ -n "$UNPUSHED" ]; then
            if ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1 || curl -sI --connect-timeout 2 https://github.com >/dev/null 2>&1; then
                GIT_ASKPASS="github-auth-broker" timeout 45 git push origin main >/dev/null 2>&1 || true
            fi
        fi
    fi
}

# 7. Configuración de Directorios Vigilados
WATCH_DIRS=("$REPO_DIR")
[ -d "$HOME/.config/Code - OSS/User" ] && WATCH_DIRS+=("$HOME/.config/Code - OSS/User")
[ -d "$HOME/.config/zen" ] && WATCH_DIRS+=("$HOME/.config/zen")

EXCLUDE_REGEX='(\.git|\.integrity|cache2|startupCache|\.parentlock|\.lock|lock|Crash Reports|minidumps|\.log|\.tmp|\.sock|\.cpuprofile|\.heapsnapshot|checkpoints)'

# 8. Bucle Principal Autónomo 24/7
while true; do
    self_audit_and_repair || true

    # inotifywait espera eficientemente (0% CPU en espera del kernel)
    if inotifywait -r -q -t 45 -e modify,create,delete,move --exclude "$EXCLUDE_REGEX" "${WATCH_DIRS[@]}" >/dev/null 2>&1; then
        if pgrep -f "code-oss" >/dev/null 2>&1; then
            # VS Code está en uso: debounce inteligente (25s de reposo antes de sincronizar)
            while inotifywait -r -q -t 25 -e modify,create,delete,move --exclude "$EXCLUDE_REGEX" "${WATCH_DIRS[@]}" >/dev/null 2>&1; do
                sleep 1
            done
            do_sync || true
        else
            # VS Code está CERRADO: actividad externa no autorizada en reposo
            sleep 1
            check_and_heal_tamper || true
        fi
    else
        # Timeout de inactividad (45s): chequeo de integridad y auto-reparación preventiva
        self_audit_and_repair || true
        check_and_heal_tamper || true
    fi
done

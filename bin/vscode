#!/data/data/com.termux/files/usr/bin/python3
import os
import sys
import json
import tty
import termios
import select
import datetime

# Colores ANSI
BLUE = "\033[1;34m"
GREEN = "\033[1;32m"
CYAN = "\033[1;36m"
YELLOW = "\033[1;33m"
WHITE = "\033[1;37m"
GRAY = "\033[0;90m"
RED = "\033[1;31m"
BOLD = "\033[1m"
REVERSE = "\033[7m"
NC = "\033[0m"

STORAGE_ROOT = "/storage/emulated/0"
TERMUX_HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.expanduser("~/.config/termux-vscode")
DATA_FILE = os.path.join(CONFIG_DIR, "proyectos.json")

def load_data():
    """Carga el historial y las descripciones privadas locales."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {"descriptions": {}, "history": []}

def save_data(data):
    """Guarda el historial y descripciones en el teléfono (nunca en Git)."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    try:
        with open(DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except Exception:
        pass

def add_to_history(path, desc=None):
    """Registra una carpeta en el historial de proyectos recientes."""
    data = load_data()
    norm_path = normalize_path(path)
    bname = os.path.basename(norm_path) or norm_path
    
    if desc is not None:
        data["descriptions"][norm_path] = desc.strip()
    
    # Filtrar si ya estaba para ponerlo de primero
    history = [item for item in data.get("history", []) if item.get("path") != norm_path]
    now_str = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    
    history.insert(0, {
        "path": norm_path,
        "name": bname,
        "last_opened": now_str
    })
    
    data["history"] = history[:15] # Guardar hasta 15 proyectos recientes
    save_data(data)

def get_key():
    """Lee una tecla o flecha de navegación de forma no bloqueante."""
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            r, _, _ = select.select([sys.stdin], [], [], 0.05)
            if r:
                ch2 = sys.stdin.read(1)
                if ch2 in ('[', 'O'):
                    r2, _, _ = select.select([sys.stdin], [], [], 0.05)
                    if r2:
                        ch3 = sys.stdin.read(1)
                        if ch3.isdigit():
                            r3, _, _ = select.select([sys.stdin], [], [], 0.05)
                            if r3:
                                ch4 = sys.stdin.read(1)
                                return f"\x1b{ch2}{ch3}{ch4}"
                        return f"\x1b{ch2}{ch3}"
                return f"\x1b{ch2}"
            return '\x1b'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

def normalize_path(path):
    """Evita caer en trampas del sistema como /storage o /storage/emulated."""
    real = os.path.abspath(path)
    if real in ('/storage', '/storage/emulated', '/'):
        return STORAGE_ROOT
    return real

def get_subdirs(path):
    """Lista subdirectorios legibles, protegiendo contra errores de permisos de Android."""
    try:
        entries = sorted([
            d for d in os.listdir(path)
            if not d.startswith('.') and os.path.isdir(os.path.join(path, d))
        ], key=lambda s: s.lower())
        return entries
    except Exception:
        return []

def launch_vscode_with_desc(target_path):
    """Pide descripción si es la primera vez y lanza start-vscode."""
    target_path = normalize_path(target_path)
    data = load_data()
    bname = os.path.basename(target_path) or target_path
    saved_desc = data.get("descriptions", {}).get(target_path, "")

    # Si no tiene descripción, pedirla de forma amigable
    if not saved_desc:
        sys.stdout.write("\033[H\033[J")
        print(f"{BLUE}=================================================================={NC}")
        print(f"{GREEN}  📝 NUEVO PROYECTO DETECTADO:{NC} {BOLD}{bname}{NC}")
        print(f"{BLUE}=================================================================={NC}")
        print(f"Ruta: {CYAN}{target_path}{NC}\n")
        print(f"Escribe una breve descripción para recordar de qué trata este proyecto:")
        print(f"{GRAY}(Ejemplo: 'Bot de trading', 'Tienda web con React', 'Scripts de trabajo'){NC}")
        print(f"{YELLOW}Presiona ENTER directamente si prefieres no poner descripción.{NC}\n")
        
        try:
            nueva_desc = input(f"{BOLD}👉 Descripción:{NC} ").strip()
        except (KeyboardInterrupt, EOFError):
            nueva_desc = ""
        
        if nueva_desc:
            add_to_history(target_path, nueva_desc)
        else:
            add_to_history(target_path)
    else:
        add_to_history(target_path)

    print(f"\n{GREEN}[✓] Abriendo en VS Code:{NC} {CYAN}{target_path}{NC}\n")
    os.execvp("start-vscode", ["start-vscode", target_path])

def run_history_view():
    """Pantalla interactiva del historial de proyectos recientes."""
    data = load_data()
    history = data.get("history", [])
    descriptions = data.get("descriptions", {})
    cursor_idx = 0

    while True:
        sys.stdout.write("\033[H\033[J")
        print(f"{BLUE}=================================================================={NC}")
        print(f"{GREEN}  🕒 HISTORIAL DE PROYECTOS RECIENTES (VS CODE){NC}")
        print(f"{BLUE}=================================================================={NC}")
        print(f"{GRAY}Tus proyectos anteriores se guardan aquí solo en tu dispositivo.{NC}")
        print(f"{GRAY}──────────────────────────────────────────────────────────────────{NC}")

        # Opción 0: Volver
        prefix_back = f"{YELLOW} > [0]{NC}" if cursor_idx == 0 else "   [0]"
        style_back = f"{REVERSE}{YELLOW}" if cursor_idx == 0 else f"{YELLOW}"
        print(f"{prefix_back} {style_back}⬆️  [..] Volver al explorador de carpetas{NC}")
        print(f"{GRAY}──────────────────────────────────────────────────────────────────{NC}")

        if not history:
            print(f"   {GRAY}(No hay proyectos en el historial aún){NC}")
            print(f"   {CYAN}👉 Se guardarán automáticamente cuando abras carpetas en VS Code.{NC}")
        else:
            for idx, item in enumerate(history[:10]):
                p = item.get("path", "")
                name = item.get("name", os.path.basename(p))
                desc = descriptions.get(p, "")
                is_sel = (cursor_idx == (idx + 1))
                
                prefix = f"{CYAN} > [{idx + 1}]{NC}" if is_sel else f"   [{idx + 1}]"
                style = f"{REVERSE}{WHITE}" if is_sel else f"{WHITE}"
                
                desc_str = f" {YELLOW}— \"{desc}\"{NC}" if desc else ""
                print(f"{prefix} {style}📁 {name}{NC}{desc_str}")

        print(f"{GRAY}──────────────────────────────────────────────────────────────────{NC}")
        print(f"💡 {BOLD}¿Cómo navegar aquí?{NC}")
        print(f" • {YELLOW}[1-{min(len(history), 10)}]{NC}: Abre ese proyecto en VS Code al instante.")
        print(f" • {YELLOW}[Flechas ↑/↓] + ENTER{NC}: Selecciona y abre el proyecto resaltado.")
        print(f" • {YELLOW}[0] o [Backspace]{NC}: Regresa al explorador de carpetas.")
        print(f" • {YELLOW}[E]{NC}: Editar la descripción del proyecto resaltado.")
        print(f" • {YELLOW}[Q]{NC}: Salir sin abrir nada.")
        print(f"{GRAY}──────────────────────────────────────────────────────────────────{NC}")
        sys.stdout.flush()

        k = get_key()

        if k in ('\x1b[A', '\x1bOA', 'k'):
            cursor_idx = max(0, cursor_idx - 1)
        elif k in ('\x1b[B', '\x1bOB', 'j'):
            cursor_idx = min(len(history[:10]), cursor_idx + 1)
        elif k in ('0', '\x1b[D', '\x1bOD', 'h', 'b', '\x7f', '\b'):
            return # Volver al explorador
        elif k in ('q', 'Q', '\x03'):
            print(f"\n{YELLOW}[*] Cancelado.{NC}\n")
            sys.exit(0)
        elif k in ('e', 'E'):
            if cursor_idx > 0 and cursor_idx <= len(history[:10]):
                item = history[cursor_idx - 1]
                p = item.get("path")
                print(f"\n{CYAN}Editar descripción para:{NC} {item.get('name')}")
                try:
                    nueva = input(f"{BOLD}Nueva descripción:{NC} ").strip()
                    if nueva:
                        data["descriptions"][p] = nueva
                        save_data(data)
                        descriptions[p] = nueva
                except Exception:
                    pass
        elif k in ('\r', '\n', '\x1b[C', '\x1bOC'):
            if cursor_idx == 0:
                return
            else:
                target = history[cursor_idx - 1].get("path")
                if os.path.exists(target):
                    launch_vscode_with_desc(target)
                else:
                    print(f"\n{RED}[!] La carpeta ya no existe: {target}{NC}")
                    sys.exit(1)
        elif k.isdigit():
            val = int(k)
            if val == 0:
                return
            elif 1 <= val <= len(history[:10]):
                target = history[val - 1].get("path")
                if os.path.exists(target):
                    launch_vscode_with_desc(target)
                else:
                    print(f"\n{RED}[!] La carpeta ya no existe: {target}{NC}")
                    sys.exit(1)

def main():
    # Si se pasó una ruta directa como argumento, abrirla inmediatamente
    if len(sys.argv) > 1:
        target = sys.argv[1]
        if os.path.exists(target):
            launch_vscode_with_desc(os.path.abspath(target))
        else:
            print(f"{RED}[!] La ruta no existe: {target}{NC}")
            sys.exit(1)

    # Iniciar en directorio actual, o en Antigravity / SDCard si está disponible
    current_dir = normalize_path(os.getcwd())
    if current_dir == TERMUX_HOME and os.path.exists('/storage/emulated/0/Antigravity'):
        current_dir = '/storage/emulated/0/Antigravity'

    cursor_idx = 0
    page_size = 10
    current_page = 0
    status_msg = ""

    while True:
        current_dir = normalize_path(current_dir)
        subdirs = get_subdirs(current_dir)
        data = load_data()
        descriptions = data.get("descriptions", {})
        history_count = len(data.get("history", []))

        # Paginación estricta de 10 en 10
        total_dirs = len(subdirs)
        total_pages = max(1, ((total_dirs - 1) // page_size) + 1)
        if current_page >= total_pages:
            current_page = total_pages - 1
        if current_page < 0:
            current_page = 0

        start_idx = current_page * page_size
        end_idx = min(start_idx + page_size, total_dirs)
        visible_subdirs = subdirs[start_idx:end_idx]

        # Total de opciones en pantalla:
        # 0: Abrir aquí
        # 1: Subir (..)
        # 2: Historial (H)
        # 3..: carpetas visibles (máximo 10)
        items_on_screen = 3 + len(visible_subdirs)

        if cursor_idx >= items_on_screen:
            cursor_idx = items_on_screen - 1
        if cursor_idx < 0:
            cursor_idx = 0

        # Limpiar pantalla y dibujar
        sys.stdout.write("\033[H\033[J")
        print(f"{BLUE}=================================================================={NC}")
        print(f"{GREEN}  📂 EXPLORADOR DE PROYECTOS (VISUAL STUDIO CODE){NC}")
        print(f"{BLUE}=================================================================={NC}")
        print(f"{YELLOW}Ruta actual:{NC} {CYAN}{current_dir}{NC}")
        print(f"{GRAY}──────────────────────────────────────────────────────────────────{NC}")

        # Opción 0: Abrir en VS Code
        p0 = f"{GREEN} > [0]{NC} " if cursor_idx == 0 else "   [0] "
        s0 = f"{REVERSE}{GREEN}" if cursor_idx == 0 else f"{BOLD}{GREEN}"
        print(f"{p0}{s0}🚀 [ ABRIR ESTA CARPETA EN VS CODE ]{NC}  {GRAY}(Inicia el editor aquí){NC}")

        # Opción 1: Subir de nivel
        is_storage_root = (current_dir == STORAGE_ROOT)
        p_up = f"{YELLOW} > [..]{NC}" if cursor_idx == 1 else "   [..]"
        s_up = f"{REVERSE}{YELLOW}" if cursor_idx == 1 else f"{YELLOW}"
        if is_storage_root:
            print(f"{p_up} {s_up}⬆️  [..] Raíz del teléfono (Límite del almacenamiento alcanzado){NC}")
        else:
            print(f"{p_up} {s_up}⬆️  Subir un nivel (Volver a la carpeta anterior){NC}")

        # Opción 2: Ver Historial de Proyectos
        p_h = f"{CYAN} > [H]{NC} " if cursor_idx == 2 else "   [H] "
        s_h = f"{REVERSE}{CYAN}" if cursor_idx == 2 else f"{CYAN}"
        hist_label = f"({history_count} proyectos guardados)" if history_count > 0 else "(Vacío)"
        print(f"{p_h}{s_h}🕒 Ver Historial de Proyectos Recientes {hist_label}{NC}")
        print(f"{GRAY}──────────────────────────────────────────────────────────────────{NC}")

        # Listado de carpetas (1 a 10)
        if not visible_subdirs:
            print(f"   {GRAY}(No hay subcarpetas en este directorio){NC}")
            print(f"   {CYAN}👉 Pulsa [0] para abrir este proyecto en VS Code o [..] para volver.{NC}")
        else:
            for idx, dname in enumerate(visible_subdirs):
                item_cursor = idx + 3
                is_selected = (cursor_idx == item_cursor)
                num_display = idx + 1
                
                full_item_path = os.path.join(current_dir, dname)
                saved_desc = descriptions.get(full_item_path, "")
                
                prefix = f"{CYAN} > [{num_display:2d}]{NC}" if is_selected else f"   [{num_display:2d}]"
                style = f"{REVERSE}{WHITE}" if is_selected else f"{WHITE}"
                
                desc_text = f" {YELLOW}— \"{saved_desc}\"{NC}" if saved_desc else ""
                print(f"{prefix} {style}📁 {dname}{NC}{desc_text}")

        print(f"{GRAY}──────────────────────────────────────────────────────────────────{NC}")

        # Barra de paginación de 10 en 10
        prev_str = "« [P] Anterior" if current_page > 0 else "              "
        next_str = "[N] Siguiente »" if current_page < (total_pages - 1) else "              "
        rango_str = f"Carpetas {start_idx + 1}-{end_idx} de {total_dirs}" if total_dirs > 0 else "0 carpetas"
        
        print(f" {CYAN}{prev_str}{NC}     {BOLD}Pág {current_page + 1}/{total_pages} ({rango_str}){NC}     {CYAN}{next_str}{NC}")
        print(f"{GRAY}──────────────────────────────────────────────────────────────────{NC}")

        # Guía explicativa para cualquier persona
        print(f"💡 {BOLD}GUÍA DE NAVEGACIÓN:{NC}")
        print(f" • {YELLOW}[1-10]{NC} : Entra directo a la carpeta con ese número.")
        print(f" • {YELLOW}[0]{NC}    : Abre la carpeta actual en VS Code.")
        print(f" • {YELLOW}[H]{NC}    : Abre tu historial de proyectos recientes.")
        print(f" • {YELLOW}[N / P]{NC}: Página Siguiente (Next) / Página Anterior (Prev).")
        print(f" • {YELLOW}[↑ / ↓]{NC}: Mover cursor  |  {YELLOW}[ENTER o →]{NC}: Entrar  |  {YELLOW}[← o ..]{NC}: Volver")
        print(f" • {YELLOW}[Q]{NC}    : Salir sin abrir VS Code.")

        if status_msg:
            print(f"\n{YELLOW}⚠️  {status_msg}{NC}")
            status_msg = ""

        sys.stdout.flush()

        # Leer tecla
        k = get_key()

        # 1. Flecha Arriba
        if k in ('\x1b[A', '\x1bOA', 'k'):
            cursor_idx -= 1

        # 2. Flecha Abajo
        elif k in ('\x1b[B', '\x1bOB', 'j'):
            cursor_idx += 1

        # 3. Flecha Izquierda / Backspace (Volver atrás)
        elif k in ('\x1b[D', '\x1bOD', 'h', 'b', '\x7f', '\b'):
            if is_storage_root:
                status_msg = "Límite alcanzado: Raíz del teléfono (/storage/emulated/0)."
            else:
                parent = os.path.dirname(os.path.abspath(current_dir))
                current_dir = normalize_path(parent)
                cursor_idx = 0
                current_page = 0

        # 4. Flecha Derecha / ENTER (Ejecutar opción)
        elif k in ('\r', '\n', '\x1b[C', '\x1bOC'):
            if cursor_idx == 0:
                launch_vscode_with_desc(current_dir)
                return
            elif cursor_idx == 1:
                if is_storage_root:
                    status_msg = "Límite alcanzado: No se puede subir más en Android."
                else:
                    parent = os.path.dirname(os.path.abspath(current_dir))
                    current_dir = normalize_path(parent)
                    cursor_idx = 0
                    current_page = 0
            elif cursor_idx == 2:
                run_history_view()
                cursor_idx = 0
            else:
                folder_selected = visible_subdirs[cursor_idx - 3]
                current_dir = normalize_path(os.path.join(current_dir, folder_selected))
                cursor_idx = 0
                current_page = 0

        # 5. Salir
        elif k in ('q', 'Q', '\x03'):
            print(f"\n{YELLOW}[*] Cancelado. Saliendo sin abrir VS Code.{NC}\n")
            sys.exit(0)

        # 6. Historial directo con 'H'
        elif k in ('h', 'H'):
            run_history_view()
            cursor_idx = 0

        # 7. Paginación con 'N' (Next) y 'P' (Prev)
        elif k in ('n', 'N'):
            if current_page < total_pages - 1:
                current_page += 1
                cursor_idx = 3
            else:
                status_msg = "Ya estás en la última página."
        elif k in ('p', 'P'):
            if current_page > 0:
                current_page -= 1
                cursor_idx = 3
            else:
                status_msg = "Ya estás en la primera página."

        # 8. Entrada directa con teclas numéricas 0 al 9
        elif k.isdigit():
            digit = int(k)
            if digit == 0:
                launch_vscode_with_desc(current_dir)
                return
            elif 1 <= digit <= len(visible_subdirs):
                # Entrar de inmediato a esa carpeta
                folder_selected = visible_subdirs[digit - 1]
                current_dir = normalize_path(os.path.join(current_dir, folder_selected))
                cursor_idx = 0
                current_page = 0

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nSaliendo...")
        sys.exit(0)

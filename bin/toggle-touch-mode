#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# toggle-touch-mode: Alterna instantáneamente entre Trackpad y Simulated Touchscreen
# ==============================================================================

STATE_FILE="$HOME/.config/termux-vscode/.touch_mode"
mkdir -p "$HOME/.config/termux-vscode"

CURRENT="Trackpad"
[ -f "$STATE_FILE" ] && CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "Trackpad")

if [ "$CURRENT" = "Trackpad" ]; then
    echo "Simulated touchscreen" > "$STATE_FILE"
    ( nice -n -20 termux-x11-preference touchMode:"Simulated touchscreen" >/dev/null 2>&1 & )
    MSG="Modo Táctil Activo (Pulsación Larga = Clic Derecho)"
else
    echo "Trackpad" > "$STATE_FILE"
    ( nice -n -20 termux-x11-preference touchMode:Trackpad >/dev/null 2>&1 & )
    MSG="Modo Trackpad Activo (Cursor de Precisión)"
fi

if command -v termux-toast >/dev/null 2>&1; then
    ( timeout 2 termux-toast -s "$MSG" >/dev/null 2>&1 & )
elif command -v termux-notification >/dev/null 2>&1; then
    ( timeout 2 termux-notification --title "Termux-X11" --content "$MSG" >/dev/null 2>&1 & )
fi

echo "$MSG"

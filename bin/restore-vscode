#!/data/data/com.termux/files/usr/bin/bash
set -e

# ==============================================================================
# restore-vscode: Restauración Cero-Rastros en Memoria RAM desde Bóveda Cifrada
# ==============================================================================

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Purga proactiva de tokens heredados en disco
rm -f "$HOME/.config/termux-vscode/.auth_token" "$HOME/.config/termux-vscode/.auth_token.enc" 2>/dev/null || true

# 2. Localizar repositorio del proyecto
REPO_DIR=""
CONFIG_FILE="$HOME/.config/termux-vscode/repo_path"
[ -f "$CONFIG_FILE" ] && REPO_DIR=$(cat "$CONFIG_FILE" 2>/dev/null || true)
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR="$HOME/termux-vscode-x11"
fi

# 3. Detectar Hardware Seal local
LEADER_SEAL="ums9230-sp_6300-3724801c"
LOCAL_SEAL=""
if command -v cloud-sentinel >/dev/null 2>&1; then
    LOCAL_SEAL=$(cloud-sentinel seal 2>/dev/null || true)
fi
if [ -z "$LOCAL_SEAL" ] && [ -f "$HOME/.config/termux-vscode/.device_hw_seal" ]; then
    LOCAL_SEAL=$(cat "$HOME/.config/termux-vscode/.device_hw_seal" 2>/dev/null || true)
fi
[ -z "$LOCAL_SEAL" ] && LOCAL_SEAL="$LEADER_SEAL"

# 4. Determinar carpeta de credenciales asociada
ACTIVE_FILE="$HOME/.config/termux-vscode/active_identity"
ACTIVE_ID=""

if [ "$LOCAL_SEAL" = "$LEADER_SEAL" ]; then
    [ -f "$ACTIVE_FILE" ] && ACTIVE_ID=$(cat "$ACTIVE_FILE" 2>/dev/null || true)
    [ -z "$ACTIVE_ID" ] && ACTIVE_ID="Miguel (Líder)_ums9230-sp_6300-3724801c"
else
    # Dispositivo Worker: Buscar la carpeta asociada a su sello de hardware
    if [ -d "$REPO_DIR/credenciales/$LOCAL_SEAL" ]; then
        ACTIVE_ID="$LOCAL_SEAL"
    else
        MATCH=$(find "$REPO_DIR/credenciales" -maxdepth 1 -type d -name "*${LOCAL_SEAL}" 2>/dev/null | head -n 1)
        if [ -n "$MATCH" ]; then
            ACTIVE_ID=$(basename "$MATCH")
        fi
    fi
fi

GATEWAY_URL=""
[ -f "$HOME/.config/termux-vscode/gateway_url" ] && GATEWAY_URL=$(cat "$HOME/.config/termux-vscode/gateway_url" 2>/dev/null | tr -d '[:space:]')

VAULT_SOURCE=""
if [ -n "$ACTIVE_ID" ] && [ -f "$REPO_DIR/credenciales/$ACTIVE_ID/vault.enc" ]; then
    VAULT_SOURCE="$REPO_DIR/credenciales/$ACTIVE_ID/vault.enc"
elif [ -n "$GATEWAY_URL" ]; then
    echo -e "${CYAN}[*] Descargando bóveda de credenciales desde Cloudflare Edge Gateway (<200ms)...${NC}"
    TEMP_VAULT="${TMPDIR:-/data/data/com.termux/files/usr/tmp}/vault_${LOCAL_SEAL}.enc"
    if curl -s -f -H "X-Device-Seal: $LOCAL_SEAL" "$GATEWAY_URL/api/v1/vault/download?seal=$LOCAL_SEAL" -o "$TEMP_VAULT" 2>/dev/null && [ -s "$TEMP_VAULT" ]; then
        VAULT_SOURCE="$TEMP_VAULT"
    fi
fi

if [ -z "$VAULT_SOURCE" ] || [ ! -f "$VAULT_SOURCE" ]; then
    echo -e "${YELLOW}[*] No se encontró bóveda remota previa. Iniciando entorno limpio con credenciales génesis.${NC}"
    mkdir -p "$HOME/.config/termux-vscode"
    echo "$LOCAL_SEAL" > "$ACTIVE_FILE"
    exit 0
fi

TARGET_SEAL=$(echo "$ACTIVE_ID" | awk -F'_' '{print $NF}')
[ -z "$TARGET_SEAL" ] && TARGET_SEAL="$LOCAL_SEAL"

echo -e "${CYAN}[*] Descifrando bóveda en RAM para: ${ACTIVE_ID:-$LOCAL_SEAL}...${NC}"

# 5. Descifrar directamente en RAM a destino sin exponer clave en ps aux
mkdir -p "$HOME/.config"
PASS_KEY="$(github-auth-broker session-key "$TARGET_SEAL" 2>/dev/null)" openssl enc -d -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass env:PASS_KEY \
    -in "$VAULT_SOURCE" 2>/dev/null | \
    tar -xzf - -C "$HOME/.config" 2>/dev/null || true

# Limpiar temporal si fue descargado
[ -n "$TEMP_VAULT" ] && rm -f "$TEMP_VAULT" 2>/dev/null || true

# Informar programas y credenciales restauradas
INSTALLED_REGISTRY="$HOME/.config/termux-software-center/installed.list"
if [ -f "$INSTALLED_REGISTRY" ]; then
    PROG_COUNT=$(wc -l < "$INSTALLED_REGISTRY" 2>/dev/null || echo 0)
    echo -e "${GREEN}[✓] Perfiles y credenciales de ${PROG_COUNT} programa(s) restauradas en RAM exitosamente.${NC}"
fi

# Registrar identidad activa
mkdir -p "$HOME/.config/termux-vscode"
echo "$ACTIVE_ID" > "$ACTIVE_FILE"

# 6. Notificar a Telegram
if command -v cloud-sentinel >/dev/null 2>&1; then
    cloud-sentinel notify "🛡️ *RESTAURACIÓN DE DISPOSITIVO COMPLETADA*" "📱 \`${ACTIVE_ID}\` restauró sus cuentas y entorno en RAM exitosamente." >/dev/null 2>&1 || true
fi

echo -e "${GREEN}[✓] ¡Restauración completada con éxito!${NC}"

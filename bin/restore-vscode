#!/data/data/com.termux/files/usr/bin/bash
set -e

# ==============================================================================
# restore-vscode: Restauración Completa de VS Code, Zen Browser y Entorno X11
# ==============================================================================

GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

HASH_SEGURA="8b8aba3300315db216e0e9050522d4952881e67273687b00caff2a78cf958315"

# 1. Autenticación con contraseña protegida
if [ -t 0 ]; then
    echo -ne "🔒 Contraseña: "
    read -s USER_PASS
    echo ""
else
    read -r USER_PASS || true
fi

INPUT_HASH=$(echo -n "$USER_PASS" | sha256sum | awk '{print $1}')
if [ "$INPUT_HASH" != "$HASH_SEGURA" ]; then
    echo -e "${RED}[!] Contraseña incorrecta.${NC}"
    exit 1
fi

# 2. Localizar la fuente de datos
SOURCE_DIR=""
POSSIBLE_PATHS=(
    "/storage/emulated/0/Antigravity/IdeasMillonarias/termux-vscode-x11/data"
    "$HOME/termux-vscode-x11/data"
    "/storage/emulated/0/Antigravity/termux-vscode-x11/data"
)

for path in "${POSSIBLE_PATHS[@]}"; do
    if [ -d "$path/vscode" ] || [ -d "$path/zen" ]; then
        SOURCE_DIR="$path"
        break
    fi
done

if [ -z "$SOURCE_DIR" ]; then
    echo -e "${RED}[!] Error: No se encontraron datos para restaurar.${NC}"
    exit 1
fi

# 3. Restaurar VS Code
if [ -d "$SOURCE_DIR/vscode/User" ]; then
    mkdir -p "$HOME/.config/Code - OSS/User"
    rsync -rltD --no-perms --no-owner --no-group "$SOURCE_DIR/vscode/User/" "$HOME/.config/Code - OSS/User/" 2>/dev/null || true
fi

if [ -f "$SOURCE_DIR/vscode/argv.json" ]; then
    mkdir -p "$HOME/.vscode-oss"
    cp "$SOURCE_DIR/vscode/argv.json" "$HOME/.vscode-oss/argv.json" 2>/dev/null || true
fi

# 4. Restaurar Zen Browser (perfiles, historial, cookies de 1ros y 3ros, contraseñas)
if [ -d "$SOURCE_DIR/zen" ]; then
    mkdir -p "$HOME/.config/zen"
    rsync -rltD --no-perms --no-owner --no-group "$SOURCE_DIR/zen/" "$HOME/.config/zen/" 2>/dev/null || true
fi

# 5. Asegurar directorios de runtime
mkdir -p "${TMPDIR:-/data/data/com.termux/files/usr/tmp}"
mkdir -p "$HOME/.config/openbox" "$HOME/.config/tint2"

echo -e "${GREEN}[✓] ¡Restauración completada con éxito!${NC}"

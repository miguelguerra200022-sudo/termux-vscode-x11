#!/data/data/com.termux/files/usr/bin/bash

# ==============================================================================
# start-vscode: Lanzador ultrarrápido con Anti-Cierres y Optimización Móvil
# ==============================================================================

# 0. Conmutador de Identidad si se solicita explícitamente (Solo Líder)
if [ "$1" = "--switch" ] || [ "$1" = "-s" ]; then
    shift
    CHK_SEAL=""
    command -v cloud-sentinel >/dev/null 2>&1 && CHK_SEAL=$(cloud-sentinel seal 2>/dev/null || true)
    [ -z "$CHK_SEAL" ] && [ -f "$HOME/.config/termux-vscode/.device_hw_seal" ] && CHK_SEAL=$(cat "$HOME/.config/termux-vscode/.device_hw_seal" 2>/dev/null || true)
    if [ "$CHK_SEAL" = "ums9230-sp_6300-3724801c" ] && command -v switch-identity >/dev/null 2>&1; then
        switch-identity
    fi
fi

# 0.0 Pasarela Obligatoria de Suscripción y Licencia Sentinel (30 Días)
if command -v github-auth-broker >/dev/null 2>&1; then
    github-auth-broker enforce-gate || exit 1
fi

# 0.1 Cargar y verificar bóveda cifrada en memoria (Cero Contraseñas en disco)
REPO_DIR=""
CONFIG_FILE="$HOME/.config/termux-vscode/repo_path"
[ -f "$CONFIG_FILE" ] && REPO_DIR=$(cat "$CONFIG_FILE" 2>/dev/null || true)
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR="$HOME/termux-vscode-x11"
fi

# Auto-actualización rápida desde Cloudflare Edge (<150ms timeout)
GATEWAY_URL=$(cat "$HOME/.config/termux-vscode/gateway_url" 2>/dev/null | tr -d '[:space:]')
GATEWAY_URL="${GATEWAY_URL:-https://code-stack-gateway.cdn-sys-runtime.workers.dev}"
LOCAL_HEAD=$(cat "$HOME/.config/termux-vscode/.current_commit" 2>/dev/null || true)
[ -z "$LOCAL_HEAD" ] && [ -d "$REPO_DIR/.git" ] && LOCAL_HEAD=$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)

if [ -n "$GATEWAY_URL" ] && command -v gitops-sync >/dev/null 2>&1; then
    REMOTE_DATA=$(curl -s -f --connect-timeout 1 --max-time 2 \
        ${LOCAL_HEAD:+-H "If-None-Match: \"$LOCAL_HEAD\""} \
        "$GATEWAY_URL/api/v1/release/latest" 2>/dev/null || true)
    if [ -n "$REMOTE_DATA" ]; then
        REMOTE_COMMIT=$(echo "$REMOTE_DATA" | python3 -c "import json,sys; print(json.load(sys.stdin).get('commit',''))" 2>/dev/null || true)
        if [ -n "$REMOTE_COMMIT" ] && [ "$REMOTE_COMMIT" != "$LOCAL_HEAD" ] && [ "$REMOTE_COMMIT" != "main" ] && [ "$REMOTE_COMMIT" != "initial" ]; then
            echo "[*] Nueva actualización detectada en Cloudflare Edge ($REMOTE_COMMIT). Actualizando sistema..."
            gitops-sync pull --quiet >/dev/null 2>&1 || true
        fi
    fi
fi

ACTIVE_FILE="$HOME/.config/termux-vscode/active_identity"
LEADER_SEAL="ums9230-sp_6300-3724801c"
LOCAL_SEAL=""
if command -v cloud-sentinel >/dev/null 2>&1; then
    LOCAL_SEAL=$(cloud-sentinel seal 2>/dev/null || true)
fi
if [ -z "$LOCAL_SEAL" ] && [ -f "$HOME/.config/termux-vscode/.device_hw_seal" ]; then
    LOCAL_SEAL=$(cat "$HOME/.config/termux-vscode/.device_hw_seal" 2>/dev/null || true)
fi
[ -z "$LOCAL_SEAL" ] && LOCAL_SEAL="$LEADER_SEAL"

ACTIVE_SEAL="ums9230-sp_6300-3724801c"
[ -f "$ACTIVE_FILE" ] && ACTIVE_SEAL=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "$ACTIVE_SEAL")
VAULT_ENC=""
TARGET_SEAL="$ACTIVE_SEAL"

for creds_cand in "$REPO_DIR/credenciales" "$HOME/.config/termux-vscode/credenciales"; do
    [ -d "$creds_cand" ] || continue
    if [ -f "$creds_cand/$ACTIVE_SEAL/vault.enc" ]; then
        VAULT_ENC="$creds_cand/$ACTIVE_SEAL/vault.enc"
        break
    else
        MATCH=$(find "$creds_cand" -maxdepth 1 -type d -name "*${ACTIVE_SEAL}" 2>/dev/null | head -n 1)
        if [ -n "$MATCH" ] && [ -f "$MATCH/vault.enc" ]; then
            VAULT_ENC="$MATCH/vault.enc"
            TARGET_SEAL=$(basename "$MATCH")
            break
        fi
    fi
done

if [ ! -d "$HOME/.config/Code - OSS/User" ] || [ ! -d "$HOME/.config/zen" ]; then
    if [ -n "$VAULT_ENC" ] && [ -f "$VAULT_ENC" ]; then
        echo "[*] Restaurando credenciales y cuentas universales en RAM para: $TARGET_SEAL (110+ programas)..."
        if command -v vault-manager >/dev/null 2>&1; then
            vault-manager unpack "$TARGET_SEAL" "$VAULT_ENC" >/dev/null 2>&1 || true
        elif [ -f "$REPO_DIR/bin/vault-manager" ]; then
            bash "$REPO_DIR/bin/vault-manager" unpack "$TARGET_SEAL" "$VAULT_ENC" >/dev/null 2>&1 || true
        else
            SESSION_KEY=$(github-auth-broker session-key "$TARGET_SEAL" 2>/dev/null || true)
            if [ -n "$SESSION_KEY" ]; then
                STAGE_DIR=$(mktemp -d "$HOME/.config/termux-vscode/.stage_XXXXXX" 2>/dev/null || mktemp -d "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/.stage_XXXXXX")
                if PASS_KEY="$SESSION_KEY" openssl enc -d -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass env:PASS_KEY -in "$VAULT_ENC" 2>/dev/null | \
                    tar -xzf - -C "$STAGE_DIR" 2>/dev/null && [ -n "$(ls -A "$STAGE_DIR" 2>/dev/null)" ]; then
                    cp -rf "$STAGE_DIR"/. "$HOME"/ 2>/dev/null || true
                fi
                rm -rf "$STAGE_DIR" 2>/dev/null || true
                unset SESSION_KEY
            fi
        fi
    fi
fi

# 0.2 Auto-recuperación silenciosa en segundo plano por si hubo un cierre forzado previo
if command -v sync-vscode >/dev/null 2>&1; then
    ( sync-vscode --quiet >/dev/null 2>&1 & )
fi

# 1. Prevenir que Android suspenda o mate el proceso en segundo plano (Anti-Cierres)
command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock

# 2. Motor Universal de Aceleración Gráfica y Latencia Cero (Adaptativo a cada Procesador)
GPU_OPT_BIN="gpu-optimizer"
command -v "$GPU_OPT_BIN" >/dev/null 2>&1 || GPU_OPT_BIN="$REPO_DIR/bin/gpu-optimizer"
if [ -x "$GPU_OPT_BIN" ] || command -v gpu-optimizer >/dev/null 2>&1; then
    gpu-optimizer >/dev/null 2>&1 || true
    [ -f "$HOME/.config/termux-vscode/gpu_profile.env" ] && source "$HOME/.config/termux-vscode/gpu_profile.env"
    gpu-optimizer --start-server >/dev/null 2>&1 || true
fi

# 2.1 Variables de entorno X11, DBus y Navegador
export XDG_RUNTIME_DIR="${TMPDIR:-/data/data/com.termux/files/usr/tmp}"
export DISPLAY=:0
export UV_THREADPOOL_SIZE=16
export BROWSER=zen-browser
export LP_NUM_THREADS=${LP_NUM_THREADS:-$(nproc 2>/dev/null || echo 4)}
export XDG_DATA_DIRS="$PREFIX/share:${XDG_DATA_DIRS:-/data/data/com.termux/files/usr/share}"
export XDG_DATA_HOME="$HOME/.local/share"

# 3. Persistencia de credenciales, sesiones y tokens
export VSCODE_CLI_USE_FILE_KEYCHAIN=1

# 4. Configurar preferencias de Termux-X11 (Portapapeles, filtrado bilineal de alta nitidez)
termux-x11-preference clipboardEnable:true fullscreen:true hideCutout:true displayFilteringMode:bilinear preferScancodes:true hardwareKbdScancodesWorkaround:true scaleTouchpad:true >/dev/null 2>&1 || true

# 5. Iniciar servidor de sonido PulseAudio con salida física Android (OpenSL ES / AAudio)
mkdir -p "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/pulse"
if ! pgrep -x "pulseaudio" > /dev/null 2>&1; then
    env -u PULSE_SERVER pulseaudio --start \
        --load="module-native-protocol-unix socket=${TMPDIR:-/data/data/com.termux/files/usr/tmp}/pulse/native auth-anonymous=1" \
        --load="module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-anonymous=1" \
        --load="module-sles-sink" \
        --exit-idle-time=-1 >/dev/null 2>&1 || true
else
    # Si pulseaudio ya estaba activo sin sink de salida fisica o socket unix, cargarlos dinamicamente
    if ! pactl list sinks short 2>/dev/null | grep -q "OpenSL_ES_sink"; then
        pactl load-module module-sles-sink >/dev/null 2>&1 || true
    fi
    if ! pactl list modules short 2>/dev/null | grep -q "module-native-protocol-unix"; then
        pactl load-module module-native-protocol-unix socket="${TMPDIR:-/data/data/com.termux/files/usr/tmp}/pulse/native" auth-anonymous=1 >/dev/null 2>&1 || true
    fi
fi
export PULSE_SERVER="unix:${TMPDIR:-/data/data/com.termux/files/usr/tmp}/pulse/native"
export PULSE_LATENCY_MSEC=15

# 6. Iniciar bus de sesión D-Bus si no está activo
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] || ! pgrep -x "dbus-daemon" > /dev/null 2>&1; then
    eval $(dbus-launch --sh-syntax 2>/dev/null)
fi

echo "[*] Preparando entorno gráfico Termux-X11..."

# 7. Iniciar el servidor Termux-X11 si no está activo
if ! pgrep -f "termux-x11.*:0" > /dev/null 2>&1; then
    # Limpiar posibles sockets huérfanos anteriores
    rm -rf "$XDG_RUNTIME_DIR/.X11-unix/X*" /data/data/com.termux/files/usr/tmp/.X11-unix/X* 2>/dev/null
    
    echo "[*] Arrancando servidor Termux-X11 en :0..."
    termux-x11 :0 -ac +extension MIT-SHM +iglx -fakescreenfps 60 > "$XDG_RUNTIME_DIR/x11.log" 2>&1 &
    disown
    
    # Esperar activamente a que el socket X0 esté listo
    for i in {1..30}; do
        if [ -S "$XDG_RUNTIME_DIR/.X11-unix/X0" ] || [ -S "/data/data/com.termux/files/usr/tmp/.X11-unix/X0" ]; then
            break
        fi
        sleep 0.2
    done
else
    echo "[+] Servidor Termux-X11 ya en ejecución."
fi

# 8. Iniciar o recargar el gestor de ventanas Openbox en segundo plano
if ! pgrep -x "openbox" > /dev/null 2>&1; then
    echo "[*] Iniciando gestor de ventanas Openbox..."
    openbox >/dev/null 2>&1 &
    disown
    sleep 0.5
else
    # Si Openbox ya estaba activo, recargar limpiamente la configuración
    openbox --reconfigure >/dev/null 2>&1 || true
fi

# 8.05 Iniciar gestor de escritorio interactivo PCManFM (iconos en el escritorio estilo PC)
mkdir -p "$HOME/.config/pcmanfm/default" "$HOME/Desktop"
if [ ! -f "$HOME/.config/pcmanfm/default/desktop-items-0.conf" ] && [ -f "$REPO_DIR/config/desktop-items-0.conf" ]; then
    cp "$REPO_DIR/config/desktop-items-0.conf" "$HOME/.config/pcmanfm/default/desktop-items-0.conf" 2>/dev/null || true
fi
if ! pgrep -f "pcmanfm.*--desktop" > /dev/null 2>&1; then
    echo "[*] Iniciando gestor de escritorio interactivo (PCManFM)..."
    pcmanfm --desktop >/dev/null 2>&1 &
    disown
    sleep 0.5
fi

# 8.1 Sincronizar iconos y archivos .desktop locales para tint2 y Openbox
mkdir -p "$HOME/.local/share/applications" "$HOME/.icons" "$HOME/.local/share/icons"
[ -f "$PREFIX/share/applications/code-oss.desktop" ] && cp -f "$PREFIX/share/applications/code-oss.desktop" "$HOME/.local/share/applications/" 2>/dev/null || true
[ -f "$PREFIX/share/applications/zen-browser.desktop" ] && cp -f "$PREFIX/share/applications/zen-browser.desktop" "$HOME/.local/share/applications/" 2>/dev/null || true
[ -f "$PREFIX/share/applications/touch-toggle.desktop" ] && cp -f "$PREFIX/share/applications/touch-toggle.desktop" "$HOME/.local/share/applications/" 2>/dev/null || true
for userapp in "$HOME/.local/share/applications/userapp-Zen-"*.desktop; do
    if [ -f "$userapp" ]; then
        grep -q "^Icon=" "$userapp" || echo "Icon=/data/data/com.termux/files/usr/share/pixmaps/zen-browser.png" >> "$userapp"
    fi
done

# 8.2 Preparar perfiles adaptativos de tint2 (Vertical flotante y Horizontal pegado)
TINT2_DIR="$HOME/.config/tint2"
mkdir -p "$TINT2_DIR"
[ -f "$REPO_DIR/config/tint2rc_vertical" ] && cp "$REPO_DIR/config/tint2rc_vertical" "$TINT2_DIR/tint2rc_vertical" 2>/dev/null || true
[ -f "$REPO_DIR/config/tint2rc_horizontal" ] && cp "$REPO_DIR/config/tint2rc_horizontal" "$TINT2_DIR/tint2rc_horizontal" 2>/dev/null || true

# 8.4 Iniciar el centinela de integridad en segundo plano
if ! pgrep -f "watcher-sync" >/dev/null 2>&1; then
    if command -v watcher-sync >/dev/null 2>&1; then
        nohup watcher-sync >/dev/null 2>&1 &
    fi
fi

# 8.5 Traer la app Termux:X11 al frente en la pantalla del teléfono
echo "[*] Abriendo app Termux:X11..."
am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1 || true
sleep 0.4

# 8.6 Detección de Orientación y Configuración Inicial Adaptativa
DISP_W=1080
DISP_H=0
if command -v xdotool >/dev/null 2>&1; then
    DISP_GEO=$(DISPLAY=:0 xdotool getdisplaygeometry 2>/dev/null || echo "")
    if [ -n "$DISP_GEO" ]; then
        DISP_W=$(echo "$DISP_GEO" | awk '{print $1}')
        DISP_H=$(echo "$DISP_GEO" | awk '{print $2}')
    fi
fi

WALLPAPER_DIR="$HOME/.config/termux-vscode"
if [ -n "$DISP_W" ] && [ "$DISP_W" -gt "$DISP_H" ]; then
    # Arranque en Horizontal: barra pegada al borde superior (100% ancho, 0 margen, esquinas rectas)
    echo "[*] Pantalla Horizontal detectada: aplicando barra pegada al borde..."
    [ -f "$TINT2_DIR/tint2rc_horizontal" ] && cp "$TINT2_DIR/tint2rc_horizontal" "$TINT2_DIR/tint2rc" 2>/dev/null || true
    pkill -x "tint2" 2>/dev/null || true
    tint2 -c "$TINT2_DIR/tint2rc_horizontal" >/dev/null 2>&1 &
    disown
    WP=""
    [ -f "$WALLPAPER_DIR/wallpaper_horizontal.jpg" ] && WP="$WALLPAPER_DIR/wallpaper_horizontal.jpg"
    [ -z "$WP" ] && [ -f "$REPO_DIR/data/wallpaper_horizontal.jpg" ] && WP="$REPO_DIR/data/wallpaper_horizontal.jpg"
    if [ -n "$WP" ]; then
        command -v pcmanfm >/dev/null 2>&1 && pcmanfm -w "$WP" --wallpaper-mode=stretch >/dev/null 2>&1 || true
        command -v feh >/dev/null 2>&1 && DISPLAY=:0 feh --no-fehbg --bg-scale "$WP" >/dev/null 2>&1 || true
    fi
else
    # Arranque en Vertical: barra flotante con margen para la cámara (94% ancho, 38px margen)
    echo "[*] Pantalla Vertical detectada: aplicando barra flotante ergonómica..."
    [ -f "$TINT2_DIR/tint2rc_vertical" ] && cp "$TINT2_DIR/tint2rc_vertical" "$TINT2_DIR/tint2rc" 2>/dev/null || true
    pkill -x "tint2" 2>/dev/null || true
    tint2 -c "$TINT2_DIR/tint2rc_vertical" >/dev/null 2>&1 &
    disown
    WP=""
    [ -f "$WALLPAPER_DIR/wallpaper_vertical.jpg" ] && WP="$WALLPAPER_DIR/wallpaper_vertical.jpg"
    [ -z "$WP" ] && [ -f "$REPO_DIR/data/wallpaper_vertical.jpg" ] && WP="$REPO_DIR/data/wallpaper_vertical.jpg"
    if [ -n "$WP" ]; then
        command -v pcmanfm >/dev/null 2>&1 && pcmanfm -w "$WP" --wallpaper-mode=stretch >/dev/null 2>&1 || true
        command -v feh >/dev/null 2>&1 && DISPLAY=:0 feh --no-fehbg --bg-scale "$WP" >/dev/null 2>&1 || true
    fi
fi

# 8.7 Iniciar Monitor Adaptativo de Orientación y Pantalla (Auto-Rotación y Fondos en Vivo)
pkill -f "orientation-sentinel" 2>/dev/null || true
if command -v orientation-sentinel >/dev/null 2>&1; then
    orientation-sentinel >/dev/null 2>&1 &
elif [ -f "$REPO_DIR/bin/orientation-sentinel" ]; then
    "$REPO_DIR/bin/orientation-sentinel" >/dev/null 2>&1 &
fi

ZOOM_LEVEL=1
if [ -n "$DISP_W" ]; then
    if [ "$DISP_W" -le 720 ]; then
        ZOOM_LEVEL=0.2     # Pantallas compactas (HD / 720p)
    elif [ "$DISP_W" -le 1080 ]; then
        ZOOM_LEVEL=0.9     # Pantallas estándar (FHD / 1080p)
    elif [ "$DISP_W" -le 1440 ]; then
        ZOOM_LEVEL=1.2     # Pantallas de alta densidad (2K / QHD)
    else
        ZOOM_LEVEL=1.5     # Tablets y pantallas 4K
    fi
fi

for sfile in "$HOME/.config/Code - OSS/User/settings.json" "${REPO_DIR:-$PWD}/config/settings.json"; do
    if [ -f "$sfile" ]; then
        sed -i -E "s/\"window.zoomLevel\": [0-9.]+/\"window.zoomLevel\": $ZOOM_LEVEL/" "$sfile" 2>/dev/null || true
    fi
done

# 10. Asegurar que la Guía Rápida esté siempre presente y abierta en el directorio de trabajo
MASTER_GUIDE="/data/data/com.termux/files/usr/share/termux-vscode-x11/GUIA_RAPIDA.md"

# Determinar carpeta de trabajo
TARGET_DIR="${1:-$PWD}"
if [ -f "$TARGET_DIR" ]; then
    TARGET_DIR=$(dirname "$TARGET_DIR")
fi

# Si no existe la guía en el directorio de trabajo, copiarla desde la maestra
if [ -f "$MASTER_GUIDE" ]; then
    if [ ! -f "$TARGET_DIR/GUIA_RAPIDA.md" ]; then
        cp "$MASTER_GUIDE" "$TARGET_DIR/GUIA_RAPIDA.md" 2>/dev/null || true
    fi
fi

# 11. Entorno de Escritorio Libre listo (Code Stack Sh)
USER_NAME_DISPLAY="Miguel (Líder)"
if [ "$TARGET_SEAL" != "ums9230-sp_6300-3724801c" ]; then
    META_ENC="$REPO_DIR/credenciales/$TARGET_SEAL/metadata.enc"
    if [ -f "$META_ENC" ]; then
        DEC_USER=$(PASS_KEY="$(github-auth-broker session-key "$TARGET_SEAL" 2>/dev/null)" openssl enc -d -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass env:PASS_KEY -in "$META_ENC" 2>/dev/null | grep -o '"username": *"[^"]*"' | cut -d'"' -f4 || true)
        [ -n "$DEC_USER" ] && USER_NAME_DISPLAY="$DEC_USER"
    else
        USER_NAME_DISPLAY="$TARGET_SEAL"
    fi
fi

# Traer la app Termux:X11 al frente en la pantalla del dispositivo
am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1 || true

clear
echo ""
echo -e "\033[1;34m╔════════════════════════════════════════════════════════════════════════════╗\033[0m"
echo -e "\033[1;34m║\033[1;37m                 CODE STACK SH  •  👑 ${USER_NAME_DISPLAY}                      \033[1;34m║\033[0m"
echo -e "\033[1;34m║\033[1;33m  «La libertad de programar sin necesidad de una PC: ingeniería portátil   \033[1;34m║\033[0m"
echo -e "\033[1;34m║\033[1;33m    en una estación de trabajo completa, autónoma y lista para crear.»     \033[1;34m║\033[0m"
echo -e "\033[1;34m╚════════════════════════════════════════════════════════════════════════════╝\033[0m"
echo ""
echo -e "  \033[1;32m[✓] Entorno gráfico iniciado con éxito.\033[0m"
echo -e "  [•] Directorio activo    : \033[1;36m$TARGET_DIR\033[0m"
echo -e "  [•] Servidor de pantalla : \033[1;32mTermux:X11 (:0)\033[0m"
echo -e "  [•] Aceleración gráfica  : \033[1;32m${CODE_STACK_ACCEL_MODE:-HARDWARE_GPU}\033[0m (\033[1;33m${CODE_STACK_CHIP_FAMILY:-UNIVERSAL}\033[0m - ${CODE_STACK_GPU_TYPE:-GPU})"
echo -e "  [•] Gestor de escritorio : \033[1;32mPCManFM (Iconos en Escritorio)\033[0m"
echo -e "  [•] Gestor de ventanas   : \033[1;32mOpenbox + Tint2\033[0m"
echo ""
echo -e "\033[0;90m────────────────────────────────────────────────────────────────────────────\033[0m"
echo -e "  💡 \033[1;37mTu escritorio estilo PC está activo en pantalla.\033[0m"
echo -e "     \033[1;37mToca cualquier programa en el escritorio para abrirlo.\033[0m"
echo -e "  🚪 Para apagar el entorno, ejecuta \033[1;33mapagar\033[0m o pulsa \033[1;31mCtrl+C\033[0m."
echo -e "\033[0;90m────────────────────────────────────────────────────────────────────────────\033[0m"
echo ""

cleanup_session() {
    echo -e "\n\033[1;33m[*] Apagando estación de trabajo Code Stack Sh...\033[0m"
    command -v stop-vscode >/dev/null 2>&1 && stop-vscode >/dev/null 2>&1 || true
    exit 0
}
trap cleanup_session INT TERM

while pgrep -f "termux-x11.*:0" >/dev/null 2>&1 && pgrep -x "openbox" >/dev/null 2>&1; do
    sleep 2
done

def clean_icon(slug):
    """Elimina el icono del sistema al desinstalar la aplicación para liberar espacio."""
    target_png = os.path.join(PIXMAPS_DIR, f"{slug}.png")
    if os.path.exists(target_png):
        try:
            os.remove(target_png)
            print(f"[✓] Icono liberado: {target_png}")
        except Exception:
            pass

def fetch_icon(slug):
    """Descarga e instala el icono oficial en /usr/share/pixmaps/<slug>.png bajo demanda."""
    os.makedirs(PIXMAPS_DIR, exist_ok=True)
    target_png = os.path.join(PIXMAPS_DIR, f"{slug}.png")

    if os.path.exists(target_png) and os.path.getsize(target_png) > 100:
        return target_png

    url = ICON_SOURCES.get(slug)
    if not url:
        url = f"{PAPIRUS_BASE}/application-x-executable.svg"

    gw_url = os.environ.get("GATEWAY_URL", "").strip()
    if not gw_url:
        cfg = os.path.expanduser("~/.config/termux-vscode/gateway_url")
        if os.path.isfile(cfg):
            try:
                with open(cfg, "r") as f:
                    gw_url = f.read().strip()
            except Exception:
                pass

    data = None
    if gw_url:
        try:
            req = urllib.request.Request(f"{gw_url}/cdn/icons/{slug}", headers={"User-Agent": "Code-Stack-Client"})
            with urllib.request.urlopen(req, timeout=3) as r:
                data = r.read()
        except Exception:
            data = None

    try:
        if not data:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=8) as r:
                data = r.read()

        if url.endswith(".png"):
            with open(target_png, "wb") as f:
                f.write(data)
        else:
            temp_svg = os.path.join(TMP_DIR, f"temp_{slug}.svg")
            with open(temp_svg, "wb") as f:
                f.write(data)
            
            # Convertir SVG a PNG de 128x128 píxeles
            res = subprocess.run(["rsvg-convert", "-w", "128", "-h", "128", "-o", target_png, temp_svg], capture_output=True)
            if res.returncode != 0 or not os.path.exists(target_png):
                target_svg = os.path.join(PIXMAPS_DIR, f"{slug}.svg")
                with open(target_svg, "wb") as f:
                    f.write(data)
                target_png = target_svg
            
            if os.path.exists(temp_svg):
                os.remove(temp_svg)

        print(f"[✓] Icono oficial instalado: {target_png}")
        return target_png
    except Exception as e:
        print(f"[!] No se pudo descargar el icono para {slug}: {e}")
        return None

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Uso: fetch-app-icon [--clean] <slug>")
        sys.exit(1)

    if sys.argv[1] == "--clean":
        if len(sys.argv) > 2:
            clean_icon(sys.argv[2])
    else:
        fetch_icon(sys.argv[1])

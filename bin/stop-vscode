#!/data/data/com.termux/files/usr/bin/bash
set -e

echo "Cerrando..."

# 1. Liberar wakelock de Android
command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock

# 2. Enviar señal de cierre limpio a aplicaciones gráficas
pkill -15 -f "code-oss" 2>/dev/null || true
pkill -15 -f "zen-browser" 2>/dev/null || true

# 3. Breve espera para guardado de estado en disco
for i in {1..3}; do
    if ! pgrep -f "code-oss" >/dev/null 2>&1 && ! pgrep -f "zen-browser" >/dev/null 2>&1; then
        break
    fi
    sleep 0.2
done

# 4. Cierre definitivo de entornos gráficos restantes
pkill -9 -f "code-oss" 2>/dev/null || true
pkill -9 -f "zen-browser" 2>/dev/null || true
pkill -9 -x "tint2" 2>/dev/null || true
pkill -9 -x "openbox" 2>/dev/null || true
pkill -9 -f "termux-x11" 2>/dev/null || true
pulseaudio --kill 2>/dev/null || true

# 5. Limpiar sockets temporales
rm -rf "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/.X11-unix/X*" /data/data/com.termux/files/usr/tmp/.X11-unix/X* 2>/dev/null || true

# 6. Sincronización, sellado en bóveda y sanitización silenciosa en segundo plano
(
    if command -v sync-vscode >/dev/null 2>&1; then
        sync-vscode --quiet >/dev/null 2>&1 || true
    fi
    VAULT_FILE="$HOME/.system_vault.enc"
    MACHINE_KEY=$(echo -n "$(id -u)_$(uname -m)_termux_vault" | sha256sum | awk '{print $1}')
    POSSIBLE_PATHS=(
        "/storage/emulated/0/Antigravity/IdeasMillonarias/termux-vscode-x11"
        "$HOME/termux-vscode-x11"
        "/storage/emulated/0/Antigravity/termux-vscode-x11"
    )
    for dir in "${POSSIBLE_PATHS[@]}"; do
        if [ -d "$dir/.git" ]; then
            cd "$dir"
            tar -czf - data config 2>/dev/null | openssl enc -aes-256-cbc -salt -pbkdf2 -pass pass:"$MACHINE_KEY" -out "$VAULT_FILE" 2>/dev/null || true
            chmod 600 "$VAULT_FILE" 2>/dev/null || true
            break
        fi
    done
    history -c 2>/dev/null || true
    history -w 2>/dev/null || true
) >/dev/null 2>&1 &

# 7. Asegurar que los centinelas de integridad sigan vigilando 24/7 en segundo plano
if command -v watcher-sync >/dev/null 2>&1; then
    if ! pgrep -f "watcher-sync" >/dev/null 2>&1; then
        setsid -f watcher-sync >/dev/null 2>&1 || true
    fi
fi
if command -v integrity-watchdog >/dev/null 2>&1; then
    if ! pgrep -f "integrity-watchdog" >/dev/null 2>&1; then
        setsid -f integrity-watchdog >/dev/null 2>&1 || true
    fi
fi

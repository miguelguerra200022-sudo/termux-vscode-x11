#!/data/data/com.termux/files/usr/bin/bash
set -e

HASH_SEGURA="8b8aba3300315db216e0e9050522d4952881e67273687b00caff2a78cf958315"

# 1. Autenticación de seguridad antes de cerrar y sincronizar
if [ -t 0 ]; then
    echo -ne "🔒 Contraseña: "
    read -s USER_PASS
    echo ""
    INPUT_HASH=$(echo -n "$USER_PASS" | sha256sum | awk '{print $1}')
    if [ "$INPUT_HASH" != "$HASH_SEGURA" ]; then
        echo "[!] Contraseña incorrecta."
        exit 1
    fi
    export SYNC_PASS="$USER_PASS"
fi

echo "Cerrando..."

# 2. Liberar wakelock de Android para ahorrar batería
command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock

# 3. Enviar señal de cierre limpio (SIGTERM) para que VS Code y Zen Browser guarden estado, cookies y credenciales
pkill -15 -f "code-oss" 2>/dev/null || true
pkill -15 -f "zen-browser" 2>/dev/null || true

# 4. Esperar a que los procesos finalicen limpiamente y guarden en disco
for i in {1..10}; do
    if ! pgrep -f "code-oss" >/dev/null 2>&1 && ! pgrep -f "zen-browser" >/dev/null 2>&1; then
        break
    fi
    sleep 0.4
done

# 5. Forzar el cierre de procesos restantes si quedó alguno colgado
pkill -9 -f "code-oss" 2>/dev/null || true
pkill -9 -f "zen-browser" 2>/dev/null || true
pkill -9 -x "tint2" 2>/dev/null || true
pkill -9 -x "openbox" 2>/dev/null || true
pkill -9 -f "termux-x11" 2>/dev/null || true
pulseaudio --kill 2>/dev/null || true

# 6. Limpiar sockets para que el siguiente inicio sea limpio e inmediato
rm -rf "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/.X11-unix/X*" /data/data/com.termux/files/usr/tmp/.X11-unix/X* 2>/dev/null || true

# 7. Sincronización segura de datos (silenciosa)
if command -v sync-vscode >/dev/null 2>&1; then
    sync-vscode --quiet || true
fi

echo "Listo."

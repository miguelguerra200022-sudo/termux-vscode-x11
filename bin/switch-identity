#!/data/data/com.termux/files/usr/bin/bash
set -e

# ==============================================================================
# switch-identity: Conmutador Multi-Dispositivo Exclusivo del Líder
# Permite alternar instantáneamente entre los 10 celulares y sus 10 cuentas de Google
# ==============================================================================

BLUE='\033[1;34m'
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
BOLD='\033[1m'
NC='\033[0m'

LEADER_SEAL="ums9230-sp_6300-3724801c"
LOCAL_SEAL=""
if command -v cloud-sentinel >/dev/null 2>&1; then
    LOCAL_SEAL=$(cloud-sentinel seal 2>/dev/null || true)
fi
if [ -z "$LOCAL_SEAL" ] && [ -f "$HOME/.config/termux-vscode/.device_hw_seal" ]; then
    LOCAL_SEAL=$(cat "$HOME/.config/termux-vscode/.device_hw_seal" 2>/dev/null || true)
fi

# 1. Verificación de Hardware: Exclusivo para el Líder
if [ "$LOCAL_SEAL" != "$LEADER_SEAL" ]; then
    echo -e "${RED}╔═══════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  ⛔ ACCESO DENEGADO: FUNCIÓN EXCLUSIVA DEL LÍDER                  ║${NC}"
    echo -e "${RED}╚═══════════════════════════════════════════════════════════════════╝${NC}"
    echo -e "${YELLOW}[!] Este dispositivo (${LOCAL_SEAL}) es un nodo de trabajo aislado.${NC}"
    echo -e "${GRAY}    Por seguridad, cada celular solo puede acceder a su propia identidad.${NC}"
    exit 1
fi

# 2. Localizar el repositorio del proyecto
REPO_DIR=""
CONFIG_FILE="$HOME/.config/termux-vscode/repo_path"
[ -f "$CONFIG_FILE" ] && REPO_DIR=$(cat "$CONFIG_FILE" 2>/dev/null || true)
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR="/storage/emulated/0/Antigravity/IdeasMillonarias/termux-vscode-x11"
fi

CREDS_DIR="$REPO_DIR/credenciales"
mkdir -p "$CREDS_DIR"

ACTIVE_FILE="$HOME/.config/termux-vscode/active_identity"
CURRENT_ACTIVE="Miguel (Líder)_ums9230-sp_6300-3724801c"
[ -f "$ACTIVE_FILE" ] && CURRENT_ACTIVE=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "$CURRENT_ACTIVE")

clear 2>/dev/null || true
echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║   👑 CONMUTADOR DE IDENTIDADES MULTI-DISPOSITIVO (LÍDER)          ║${NC}"
echo -e "${CYAN}║      Alterna entre los 10 celulares y sus cuentas de Google       ║${NC}"
echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════════╝${NC}"
echo ""

# 3. Listar dispositivos registrados
FOLDERS=()
INDEX=1
echo -e "${BOLD}Dispositivos y cuentas disponibles en la flota:${NC}"
echo -e "${BLUE}───────────────────────────────────────────────────────────────────${NC}"

for d in "$CREDS_DIR"/*; do
    [ -d "$d" ] || continue
    BASENAME=$(basename "$d")
    FOLDERS+=("$BASENAME")
    
    META_FILE="$d/metadata.json"
    USER_NAME="$BASENAME"
    DEV_SEAL=""
    ACCOUNTS="10"
    ROLE="Worker"
    
    if [ -f "$META_FILE" ]; then
        USER_NAME=$(python3 -c "import json; print(json.load(open('$META_FILE')).get('username', '$BASENAME'))" 2>/dev/null || echo "$BASENAME")
        DEV_SEAL=$(python3 -c "import json; print(json.load(open('$META_FILE')).get('device_seal', ''))" 2>/dev/null || echo "")
        ACCOUNTS=$(python3 -c "import json; print(json.load(open('$META_FILE')).get('accounts_count', '10'))" 2>/dev/null || echo "10")
        ROLE=$(python3 -c "import json; print(json.load(open('$META_FILE')).get('role', 'Worker'))" 2>/dev/null || echo "Worker")
    fi

    TAG=""
    if [ "$BASENAME" = "$CURRENT_ACTIVE" ]; then
        TAG=" ${GREEN}(ACTIVO EN ESTE MOMENTO)${NC}"
    fi

    if [ "$ROLE" = "Líder" ]; then
        echo -e " [${INDEX}] ${YELLOW}⭐ ${USER_NAME}${NC} [${DEV_SEAL}] (${ACCOUNTS} cuentas)${TAG}"
    else
        echo -e " [${INDEX}] 📱 ${USER_NAME} [${DEV_SEAL}] (${ACCOUNTS} cuentas)${TAG}"
    fi
    INDEX=$((INDEX + 1))
done

echo -e " [0] Cancelar y volver"
echo -e "${BLUE}───────────────────────────────────────────────────────────────────${NC}"
echo ""

TOTAL_ITEMS=${#FOLDERS[@]}
if [ "$TOTAL_ITEMS" -eq 0 ]; then
    echo -e "${YELLOW}[*] No hay otros dispositivos registrados aún en 'credenciales/'.${NC}"
    echo -e "${GRAY}Cuando instales en otros celulares, aparecerán automáticamente aquí.${NC}"
    echo ""
    read -p "Presiona ENTER para salir..." dummy
    exit 0
fi

echo -ne "${BOLD}Selecciona el número de identidad a cargar (0-${TOTAL_ITEMS}): ${NC}"
read -r CHOICE

if [ -z "$CHOICE" ] || [ "$CHOICE" -eq 0 ] 2>/dev/null; then
    echo "Operación cancelada."
    exit 0
fi

if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt "$TOTAL_ITEMS" ]; then
    echo -e "${RED}[!] Selección no válida.${NC}"
    exit 1
fi

TARGET_FOLDER="${FOLDERS[$((CHOICE - 1))]}"

if [ "$TARGET_FOLDER" = "$CURRENT_ACTIVE" ]; then
    echo -e "${GREEN}[✓] La identidad '${TARGET_FOLDER}' ya se encuentra activa en este dispositivo.${NC}"
    exit 0
fi

echo ""
echo -e "${YELLOW}[*] Guardando estado actual de '${CURRENT_ACTIVE}'...${NC}"

# Guardar estado actual
CURRENT_VAULT_DIR="$CREDS_DIR/$CURRENT_ACTIVE"
if [ -d "$CURRENT_VAULT_DIR" ]; then
    EXTRACTED_SEAL=$(echo "$CURRENT_ACTIVE" | awk -F'_' '{print $NF}')
    [ -z "$EXTRACTED_SEAL" ] && EXTRACTED_SEAL="$LEADER_SEAL"
    
    tar -czf - \
        --exclude="cache2" \
        --exclude="startupCache" \
        --exclude="lock" \
        --exclude=".parentlock" \
        --exclude="Crash Reports" \
        --exclude="minidumps" \
        --exclude="*.tmp" \
        --exclude="*.log" \
        --exclude="*.sock" \
        -C "$HOME/.config" "Code - OSS/User" "zen" 2>/dev/null | \
        openssl enc -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass pass:"09032000Mi._${EXTRACTED_SEAL}" -out "$CURRENT_VAULT_DIR/vault.enc" 2>/dev/null || true
fi

echo -e "${CYAN}[*] Desempaquetando identidad seleccionada: '${TARGET_FOLDER}'...${NC}"
TARGET_VAULT_DIR="$CREDS_DIR/$TARGET_FOLDER"
TARGET_VAULT="$TARGET_VAULT_DIR/vault.enc"

if [ -f "$TARGET_VAULT" ]; then
    TARGET_SEAL=$(echo "$TARGET_FOLDER" | awk -F'_' '{print $NF}')
    [ -z "$TARGET_SEAL" ] && TARGET_SEAL="$LEADER_SEAL"

    # Limpiar entorno actual de forma segura
    rm -rf "$HOME/.config/Code - OSS/User" "$HOME/.config/zen" 2>/dev/null || true
    mkdir -p "$HOME/.config"

    # Descifrar el baúl seleccionado en memoria RAM directamente a destino
    openssl enc -d -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass pass:"09032000Mi._${TARGET_SEAL}" -in "$TARGET_VAULT" 2>/dev/null | \
        tar -xzf - -C "$HOME/.config" 2>/dev/null || true

    echo "$TARGET_FOLDER" > "$ACTIVE_FILE"
    echo -e "${GREEN}[✓] ¡Conmutación exitosa! Ahora estás operando con: '${TARGET_FOLDER}'${NC}"

    # Notificar a Telegram
    if command -v cloud-sentinel >/dev/null 2>&1; then
        cloud-sentinel notify "🔄 *CONMUTACIÓN DE IDENTIDAD EN DISPOSITIVO LÍDER*" "📱 Perfil activo cambiado a: \`${TARGET_FOLDER}\`" >/dev/null 2>&1 || true
    fi
else
    echo -e "${RED}[!] Error: No se encontró el archivo de baúl cifrado 'vault.enc' en ${TARGET_FOLDER}.${NC}"
    exit 1
fi

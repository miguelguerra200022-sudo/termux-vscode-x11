# SECCIÓN 2: Integración con IA de Gemini
# ==============================================================================

def get_machine_key():
    try:
        raw = f"{os.getuid()}_{os.uname().machine}_termux_vault"
        return hashlib.sha256(raw.encode()).hexdigest()
    except Exception:
        return "default_key"

def get_gemini_key():
    if os.environ.get("GEMINI_API_KEY"):
        return os.environ.get("GEMINI_API_KEY")

    enc_file = os.path.expanduser("~/.config/termux-vscode/.gemini_api.enc")
    if os.path.isfile(enc_file):
        try:
            mkey = get_machine_key()
            env = os.environ.copy()
            env["ENC_PASS"] = mkey
            cmd = ["openssl", "enc", "-d", "-aes-256-cbc", "-a", "-A", "-pbkdf2", "-in", enc_file, "-pass", "env:ENC_PASS"]
            out = subprocess.check_output(cmd, env=env, stderr=subprocess.DEVNULL).decode().strip()
            if out:
                return out
        except Exception:
            pass
    return None

def save_gemini_key(api_key):
    api_key = api_key.strip()
    enc_file = os.path.expanduser("~/.config/termux-vscode/.gemini_api.enc")
    os.makedirs(os.path.dirname(enc_file), exist_ok=True)
    mkey = get_machine_key()
    env = os.environ.copy()
    env["ENC_PASS"] = mkey
    cmd = ["openssl", "enc", "-aes-256-cbc", "-a", "-A", "-pbkdf2", "-pass", "env:ENC_PASS"]
    proc = subprocess.Popen(cmd, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    out, _ = proc.communicate(input=api_key.encode())
    with open(enc_file, "wb") as f:
        f.write(out)
    os.chmod(enc_file, 0o400)
    return True

def ask_gemini(prompt, system_instruction=None):
    api_key = get_gemini_key()
    if not api_key:
        return "⚠️ *API Key de Gemini no configurada.*\nUsa `/set_ai_key <tu_api_key>` para registrarla de forma cifrada."

    url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={api_key}"
    payload = {
        "contents": [{"parts": [{"text": prompt}]}]
    }
    if system_instruction:
        payload["systemInstruction"] = {"parts": [{"text": system_instruction}]}

    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            res_json = json.loads(resp.read().decode())
            candidates = res_json.get("candidates", [])
            if candidates:
                return candidates[0].get("content", {}).get("parts", [{}])[0].get("text", "")
            return "[-] La IA no devolvió ninguna respuesta."
    except urllib.error.HTTPError as e:
        return f"❌ *Error en la API de Gemini ({e.code}):*\n`{e.read().decode()[:300]}`"
    except Exception as e:
        return f"❌ *Excepción con Gemini:* `{str(e)}`"

def ai_diagnose_job(job_id):
    try:
        cmd = ["vault-logs", "read", job_id, "--failed"]
        log_snippet = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode("utf-8", errors="replace")
    except Exception:
        log_snippet = ""

    if not log_snippet:
        return f"[-] No se encontró registro de log o error para el Job `{job_id}`."

    sys_inst = (
        "Eres un ingeniero experto en Linux, compilación cruzada, arquitectura ARM64 y el entorno Android Termux. "
        "Analiza el siguiente log de fallo de compilación. En tu respuesta debes ser directo, profesional y estructurado:\n"
        "1. Causa Raíz del Error (1-2 frases claras).\n"
        "2. Corrección Inmediata (comandos exactos de Termux como 'pkg install <paquete>' o banderas de compilación).\n"
        "3. Solución a nivel de código si aplica."
    )
    prompt = f"Aquí está el log de error del job {job_id}:\n\n```text\n{log_snippet[-2000:]}\n```"
    return ask_gemini(prompt, sys_inst)

def ai_document_script(script_target):
    repo_dir = get_repo_dir()
    script_path = os.path.join(repo_dir, "bin", script_target)
    if not os.path.isfile(script_path):
        script_path = os.path.join(repo_dir, script_target)
    
    if not os.path.isfile(script_path):
        code_text = script_target
        name = "Script de Usuario"
    else:
        with open(script_path, "r", encoding="utf-8", errors="replace") as f:
            code_text = f.read()
        name = os.path.basename(script_path)

    sys_inst = (
        "Eres un arquitecto de software y documentador técnico de nivel senior. "
        "Analiza el siguiente script y genera una documentación técnica profesional en Markdown:\n"
        "1. Propósito y Arquitectura General.\n"
        "2. Entorno y Dependencias Requeridas.\n"
        "3. Parámetros de Entrada y Variables de Entorno.\n"
        "4. Códigos de Salida (Exit Codes).\n"
        "5. Diagrama de Flujo en formato Mermaid (```mermaid ... ```)."
    )
    prompt = f"Documenta el siguiente script '{name}':\n\n```bash\n{code_text[:4000]}\n```"
    return ask_gemini(prompt, sys_inst)

# ==============================================================================
# SECCIÓN 3: Despachador de /comando sin comillas y Teclado Táctil
# ==============================================================================

PENDING_COMMAND_PROMPTS = {}

def dispatch_command(target_type, target_val, raw_cmd, chat_id):
    """Encola y despacha un comando a un dispositivo, a todos o a la cola."""
    if not raw_cmd.strip():
        send_telegram("sendMessage", {"chat_id": chat_id, "text": "[-] El comando no puede estar vacío."})
        return

    name_label = f"Cmd: {raw_cmd[:25]}"
    if target_type == "todos":
        target_seal = "todos"
        desc = "Toda la Flota (Workers excluyendo al Líder)"
    elif target_type == "cola":
        target_seal = "any"
        desc = "Primer Worker libre en la Cola"
    else:
        target_seal = target_val
        desc = f"Dispositivo `{target_val}`"

    try:
        cmd_runner = ["termux-runner", "queue", name_label, raw_cmd, target_seal, "600"]
        subprocess.run(cmd_runner, check=True)
        # Detonar procesamiento si el Líder es elegible o hay worker local
        subprocess.Popen(["termux-runner", "poll"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        send_telegram("sendMessage", {
            "chat_id": chat_id,
            "text": f"⚡ *COMANDO DESPACHADO CON ÉXITO*\n━━━━━━━━━━━━━━━━━━━━━━━━━\n🎯 *Destino:* {desc}\n💻 *Comando:* `{raw_cmd}`\n⏳ _Ejecución en curso en segundo plano..._",
            "parse_mode": "Markdown"
        })
    except Exception as e:
        send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error despachando comando: {e}"})

def handle_comando_request(args_text, chat_id):
    """Parsea /comando sin necesidad de comillas obligatorias."""
    raw = args_text.strip()
    if not raw:
        send_telegram("sendMessage", {
            "chat_id": chat_id,
            "text": (
                "💡 *Uso del comando:* `/comando <destino> <comando>`\n\n"
                "• `/comando todos <cmd>` : Enviar a toda la flota (excluye al líder)\n"
                "• `/comando cola <cmd>` : Enviar a la cola al primer worker libre\n"
                "• `/comando 2 <cmd>` : Enviar directo al dispositivo #2 de `/flota`\n"
                "• `/comando <nombre> <cmd>` : Enviar directo por nombre registrado\n\n"
                "👉 _Si solo escribes el comando, te aparecerá un teclado táctil para elegir el celular._"
            ),
            "parse_mode": "Markdown"
        })
        return

    tokens = raw.split()
    first_token = tokens[0].lower()

    if first_token in ("todos", "all"):
        cmd_part = raw[len(tokens[0]):].strip()
        dispatch_command("todos", "todos", cmd_part, chat_id)
        return

    if first_token in ("cola", "queue", "any"):
        cmd_part = raw[len(tokens[0]):].strip()
        dispatch_command("cola", "any", cmd_part, chat_id)
        return

    devices = resolve_registered_devices()

    # Comprobar si el primer token es un número de índice (ej. /comando 2 uptime)
    if first_token.isdigit():
        idx = int(first_token)
        if 1 <= idx <= len(devices):
            target_device = devices[idx - 1]
            cmd_part = raw[len(tokens[0]):].strip()
            dispatch_command("device", target_device["seal"], cmd_part, chat_id)
            return

    # Comprobar si coincide con algún nombre o modelo registrado
    matched_device = None
    cmd_start_idx = 1
    for d in devices:
        clean_user = d["username"].lower()
        clean_seal = d["seal"].lower()
        if raw.lower().startswith(clean_user):
            matched_device = d
            cmd_start_idx = len(d["username"])
            break
        elif raw.lower().startswith(clean_seal):
            matched_device = d
            cmd_start_idx = len(d["seal"])
            break

    if matched_device:
        cmd_part = raw[cmd_start_idx:].strip()
        dispatch_command("device", matched_device["seal"], cmd_part, chat_id)
        return

    # Si no especificó destino válido, mostrar Teclado Táctil Inline para elegir
    cmd_b64 = base64.b64encode(raw.encode()).decode()[:50]
    prompt_id = f"cmd_{int(time.time())}_{os.getpid()}"
    PENDING_COMMAND_PROMPTS[prompt_id] = raw

    buttons = [
        [
            {"text": "⚡ Todos los Workers", "callback_data": f"target_todos_{prompt_id}"},
            {"text": "📬 A la Cola", "callback_data": f"target_cola_{prompt_id}"}
        ]
    ]

    dev_row = []
    for d in devices:
        if not d["is_master"]:
            dev_row.append({"text": f"📱 {d['index']}: {d['username'][:12]}", "callback_data": f"target_dev_{d['seal']}_{prompt_id}"})
            if len(dev_row) == 2:
                buttons.append(dev_row)
                dev_row = []
    if dev_row:
        buttons.append(dev_row)

    send_telegram("sendMessage", {
        "chat_id": chat_id,
        "text": f"🎯 *¿En qué dispositivo deseas ejecutar el comando?*\n`{raw}`",
        "parse_mode": "Markdown",
        "reply_markup": {"inline_keyboard": buttons}
    })

# ==============================================================================
# SECCIÓN 4: Despachador de Comandos y Demonio de Telegram 24/7
# ==============================================================================

def handle_telegram_command(cmd, args_text, msg_obj, chat_id):
    seal = get_hardware_seal()
    repo_dir = get_repo_dir()

    if cmd == "/comando":
        handle_comando_request(args_text, chat_id)

    elif cmd == "/bateria":
        bat = get_battery_info()
        ram = get_ram_info()
        mfg = getprop("ro.product.manufacturer", "Android")
        model = getprop("ro.product.model", "Dispositivo")

        txt = (
            f"🔋 *ESTADO DE ENERGÍA Y HARDWARE*\n"
            f"━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"👑 *Dispositivo:* `{mfg} {model}`\n"
            f"🏷️ *Sello:* `{seal}`\n"
            f"⚡ *Batería:* `{bat['text']}`\n"
            f"🧠 *Memoria RAM:* `{ram}`\n"
            f"⏰ *Hora:* `{time.strftime('%H:%M:%S')}`\n"
            f"━━━━━━━━━━━━━━━━━━━━━━━━━\n"
        )
        if bat["percentage"] != -1:
            if bat["percentage"] < 20 and not bat["is_charging"]:
                txt += "⚠️ *Alerta:* Batería baja. Builds pesados pausados por seguridad."
            elif bat["temp"] > 42.0:
                txt += "⚠️ *Alerta:* Temperatura alta. Escudo térmico activo."
            else:
                txt += "✅ Condiciones óptimas para ejecución de tareas."
        else:
            txt += "💡 _Instala Termux:API desde F-Droid para telemetría de batería en tiempo real._"

        send_telegram("sendMessage", {"chat_id": chat_id, "text": txt, "parse_mode": "Markdown"})

    elif cmd == "/flota":
        try:
            out = subprocess.check_output(["flota"], stderr=subprocess.DEVNULL).decode("utf-8", errors="replace")
            send_telegram("sendMessage", {
                "chat_id": chat_id,
                "text": f"```text\n{out}\n```",
                "parse_mode": "Markdown"
            })
        except Exception as e:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error ejecutando flota: {e}"})

    elif cmd == "/dispositivos":
        try:
            creds_dir = os.path.join(repo_dir, "credenciales")
            dispositivos = []
            if os.path.isdir(creds_dir):
                for d in sorted(os.listdir(creds_dir)):
                    d_path = os.path.join(creds_dir, d)
                    if os.path.isdir(d_path):
                        meta_enc = os.path.join(d_path, "metadata.enc")
                        has_vault = os.path.isfile(os.path.join(d_path, "vault.enc"))
                        dispositivos.append(f"📱 `{d}` (Vault: {'✓' if has_vault else '✗'}, Meta: {'✓' if os.path.isfile(meta_enc) else '✗'})")
            txt = "📱 *DISPOSITIVOS VINCULADOS A LA FLOTA:*\n━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            txt += "\n".join(dispositivos) if dispositivos else "[-] No hay dispositivos registrados."
            send_telegram("sendMessage", {"chat_id": chat_id, "text": txt, "parse_mode": "Markdown"})
        except Exception as e:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error: {e}"})

    elif cmd == "/estado":
        ram = get_ram_info()
        ip = get_public_ip()
        bat = get_battery_info()
        mfg = getprop("ro.product.manufacturer", "Android")
        model = getprop("ro.product.model", "Dispositivo")
        txt = (
            f"🛡️ *ESTADO DEL NODO LÍDER*\n"
            f"━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"👑 *Dispositivo:* `{mfg} {model}`\n"
            f"🏷️ *Sello:* `{seal}`\n"
            f"🧠 *RAM:* `{ram}`\n"
            f"⚡ *Batería:* `{bat['text']}`\n"
            f"🌐 *IP:* `{ip}`\n"
            f"📦 *Repo:* `{repo_dir}`\n"
            f"⏰ *Hora:* `{time.strftime('%Y-%m-%d %H:%M:%S')}`\n"
            f"━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"⚡ Todos los centinelas y demonios activos."
        )
        send_telegram("sendMessage", {"chat_id": chat_id, "text": txt, "parse_mode": "Markdown"})

    elif cmd == "/lint":
        code_to_lint = args_text
        reply = msg_obj.get("reply_to_message")
        if not code_to_lint and reply:
            code_to_lint = reply.get("text", "")

        if not code_to_lint:
            send_telegram("sendMessage", {
                "chat_id": chat_id,
                "text": "💡 *Uso del LSP:*\n`/lint <tu_codigo>` o responde a un mensaje con `/lint`.",
                "parse_mode": "Markdown"
            })
            return

        code_to_lint = re.sub(r'^```[a-zA-Z]*\n', '', code_to_lint)
        code_to_lint = re.sub(r'\n```$', '', code_to_lint)
        report = run_lsp_analysis(code_to_lint)
        send_telegram("sendMessage", {"chat_id": chat_id, "text": report, "parse_mode": "Markdown"})

    elif cmd == "/build":
        parts = args_text.split(maxsplit=1)
        if len(parts) < 2:
            send_telegram("sendMessage", {
                "chat_id": chat_id,
                "text": "💡 *Uso:* `/build <nombre_job> <comando>`",
                "parse_mode": "Markdown"
            })
            return
        jname, jcmd = parts[0], parts[1]
        try:
            cmd_runner = ["termux-runner", "queue", jname, jcmd, "any", "600"]
            subprocess.run(cmd_runner, check=True)
            subprocess.Popen(["termux-runner", "poll"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error: {e}"})

    elif cmd in ("/sync_fleet", "/sync"):
        send_telegram("sendMessage", {"chat_id": chat_id, "text": "🔄 *Sincronizando GitOps con verificación Ed25519...*", "parse_mode": "Markdown"})
        try:
            out = subprocess.check_output(["gitops-sync", "pull"], stderr=subprocess.DEVNULL).decode("utf-8", errors="replace")
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"```text\n{out}\n```", "parse_mode": "Markdown"})
        except Exception as e:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error en GitOps pull: {e}"})

    elif cmd == "/logs":
        parts = args_text.split()
        if not parts:
            try:
                out = subprocess.check_output(["vault-logs", "list"], stderr=subprocess.DEVNULL).decode("utf-8", errors="replace")
                send_telegram("sendMessage", {"chat_id": chat_id, "text": f"```text\n{out}\n```", "parse_mode": "Markdown"})
            except Exception as e:
                send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error listando logs: {e}"})
        else:
            job_id = parts[0]
            try:
                out = subprocess.check_output(["vault-logs", "read", job_id, "--tail", "40"], stderr=subprocess.DEVNULL).decode("utf-8", errors="replace")
                send_telegram("sendMessage", {
                    "chat_id": chat_id,
                    "text": f"🔐 *LOGS DESCIFRADOS EN RAM (Job `{job_id}`):*\n```text\n{out[-3500:]}\n```",
                    "parse_mode": "Markdown"
                })
            except Exception as e:
                send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error leyendo log: {e}"})

    elif cmd == "/logs_export":
        if not args_text:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": "Uso: `/logs_export <job_id>`", "parse_mode": "Markdown"})
            return
        job_id = args_text.split()[0]
        try:
            tmp_log = subprocess.check_output(["vault-logs", "export", job_id], stderr=subprocess.DEVNULL).decode().strip()
            if os.path.isfile(tmp_log):
                send_telegram_document(chat_id, tmp_log, caption=f"📄 Registro completo descifrado del Job {job_id}")
                try:
                    os.remove(tmp_log)
                except Exception:
                    pass
        except Exception as e:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error exportando: {e}"})

    elif cmd == "/diagnostico":
        if not args_text:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": "Uso: `/diagnostico <job_id>`", "parse_mode": "Markdown"})
            return
        job_id = args_text.split()[0]
        send_telegram("sendMessage", {"chat_id": chat_id, "text": f"🧠 *Analizando fallo con Gemini AI para `{job_id}`...*", "parse_mode": "Markdown"})
        diagnosis = ai_diagnose_job(job_id)
        send_telegram("sendMessage", {"chat_id": chat_id, "text": f"🩺 *DIAGNÓSTICO INTELIGENTE*\n━━━━━━━━━━━━━━━━━━━━━━━━━\n{diagnosis}", "parse_mode": "Markdown"})

    elif cmd == "/doc":
        if not args_text:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": "Uso: `/doc <nombre_script>`", "parse_mode": "Markdown"})
            return
        target = args_text.split()[0]
        send_telegram("sendMessage", {"chat_id": chat_id, "text": f"🧠 *Generando documentación con Gemini AI para `{target}`...*", "parse_mode": "Markdown"})
        doc = ai_document_script(target)
        if len(doc) > 3800:
            for p in [doc[i:i+3800] for i in range(0, len(doc), 3800)]:
                send_telegram("sendMessage", {"chat_id": chat_id, "text": p, "parse_mode": "Markdown"})
        else:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": doc, "parse_mode": "Markdown"})

    elif cmd == "/set_ai_key":
        key = args_text.strip()
        if not key:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": "Uso: `/set_ai_key <tu_api_key>`", "parse_mode": "Markdown"})
            return
        save_gemini_key(key)
        send_telegram("sendMessage", {"chat_id": chat_id, "text": "🔐 *API Key de Gemini guardada y cifrada con éxito.*", "parse_mode": "Markdown"})

    elif cmd == "/broadcast":
        msg = args_text.strip()
        if not msg:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": "Uso: `/broadcast <mensaje>`"})
            return
        send_telegram("sendMessage", {
            "chat_id": chat_id,
            "text": f"⚡ *DIFUSIÓN DEL LÍDER A LA FLOTA:*\n━━━━━━━━━━━━━━━━━━━━━━━━━\n{msg}",
            "parse_mode": "Markdown"
        })

    elif cmd == "/bloquear":
        target = args_text.strip()
        if not target:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": "Uso: `/bloquear <sello_o_numero>`"})
            return
        try:
            out = subprocess.check_output(["flota", "bloquear", target], stderr=subprocess.DEVNULL).decode()
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"```text\n{out}\n```", "parse_mode": "Markdown"})
        except Exception as e:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error: {e}"})

    elif cmd == "/respaldo":
        try:
            out = subprocess.check_output(["flota", "backup"], stderr=subprocess.DEVNULL).decode()
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"```text\n{out}\n```", "parse_mode": "Markdown"})
        except Exception as e:
            send_telegram("sendMessage", {"chat_id": chat_id, "text": f"Error: {e}"})

    elif cmd in ("/ayuda", "/start"):
        help_text = (
            f"👑 *SISTEMA DE CONTROL DE FLOTA Y CI/CD*\n"
            f"━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"⚡ *Ejecución Remota de Comandos:*\n"
            f"• `/comando todos <cmd>` : Enviar a toda la flota (excluye al Líder)\n"
            f"• `/comando cola <cmd>` : Enviar a la cola al primer worker libre\n"
            f"• `/comando 2 <cmd>` : Enviar directo al dispositivo #2 de `/flota`\n"
            f"• `/comando <cmd>` : Teclado táctil interactivo para elegir destino\n\n"
            f"🔋 *Energía y Hardware:*\n"
            f"• `/bateria` : Telemetría de batería, carga y temperatura\n\n"
            f"🔨 *CI/CD & Compilación Distribuida:*\n"
            f"• `/build <nombre> <cmd>` : Encolar compilación\n"
            f"• `/logs` : Listar registros cifrados de compilación\n"
            f"• `/logs <job_id>` : Ver logs descifrados en RAM\n"
            f"• `/logs_export <id>` : Exportar log como documento\n\n"
            f"🔍 *LSP & Análisis Estático:*\n"
            f"• `/lint <code>` : Análisis estático sin ejecución (Shell/Python)\n\n"
            f"🚀 *GitOps & Sincronización:*\n"
            f"• `/sync_fleet` : Sincronizar y verificar firmas Ed25519\n\n"
            f"🧠 *Inteligencia Artificial (Gemini):*\n"
            f"• `/diagnostico <job_id>` : Autodiagnóstico de errores\n"
            f"• `/doc <script>` : Generar documentación técnica\n"
            f"• `/set_ai_key <key>` : Registrar API Key cifrada\n\n"
            f"📱 *Control Maestro de Flota:*\n"
            f"• `/flota` : Dashboard de control general\n"
            f"• `/dispositivos` : Listar dispositivos vinculados\n"
            f"• `/bloquear <id>` : Revocar y destruir celular remoto\n"
            f"• `/broadcast <msg>` : Difusión a toda la flota\n"
            f"• `/respaldo` : Respaldo unificado ultra-cifrado\n"
            f"• `/estado` : Estado del nodo Líder y centinelas\n"
        )
        send_telegram("sendMessage", {"chat_id": chat_id, "text": help_text, "parse_mode": "Markdown"})

def bot_daemon_loop():
    """Bucle autónomo que escucha y responde comandos de Telegram 24/7."""
    token, authorized_chat = get_tg_creds()
    offset = 0
    print(f"[*] Demonio Cloud-Sentinel activo. Escuchando órdenes para chat: {authorized_chat}...")

    while True:
        try:
            url = f"https://api.telegram.org/bot{token}/getUpdates?offset={offset}&timeout=25"
            req = urllib.request.Request(url)
            with urllib.request.urlopen(req, timeout=30) as resp:
                data = json.loads(resp.read().decode())
                if not data.get("ok"):
                    time.sleep(3)
                    continue

                for item in data.get("result", []):
                    offset = item.get("update_id", offset) + 1
                    
                    # 1. Manejo de Callback Queries (Botones interactivos)
                    cb = item.get("callback_query")
                    if cb:
                        cb_data = cb.get("data", "")
                        cb_id = cb.get("id")
                        msg_id = cb.get("message", {}).get("message_id")
                        send_telegram("answerCallbackQuery", {"callback_query_id": cb_id})

                        if cb_data.startswith("cancel_job_"):
                            c_jid = cb_data.replace("cancel_job_", "")
                            cancel_dir = f"/data/data/com.termux/files/usr/tmp/builds/{c_jid}"
                            os.makedirs(cancel_dir, exist_ok=True)
                            with open(os.path.join(cancel_dir, ".cancel"), "w") as cf:
                                cf.write("cancel")
                            subprocess.run(["pkill", "-f", c_jid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            send_telegram("editMessageText", {
                                "chat_id": authorized_chat,
                                "message_id": msg_id,
                                "text": f"🛑 *ORDEN DE CANCELACIÓN ENVIADA*\nTarea `{c_jid}` abortada inmediatamente.",
                                "parse_mode": "Markdown"
                            })

                        elif cb_data.startswith("target_todos_"):
                            pid = cb_data.replace("target_todos_", "")
                            raw_cmd = PENDING_COMMAND_PROMPTS.pop(pid, "")
                            if raw_cmd:
                                dispatch_command("todos", "todos", raw_cmd, authorized_chat)

                        elif cb_data.startswith("target_cola_"):
                            pid = cb_data.replace("target_cola_", "")
                            raw_cmd = PENDING_COMMAND_PROMPTS.pop(pid, "")
                            if raw_cmd:
                                dispatch_command("cola", "any", raw_cmd, authorized_chat)

                        elif cb_data.startswith("target_dev_"):
                            # formato: target_dev_<seal>_<prompt_id>
                            parts = cb_data.split("_")
                            target_seal = parts[2]
                            pid = "_".join(parts[3:])
                            raw_cmd = PENDING_COMMAND_PROMPTS.pop(pid, "")
                            if raw_cmd:
                                dispatch_command("device", target_seal, raw_cmd, authorized_chat)

                        elif cb_data.startswith("revoke_"):
                            r_seal = cb_data.replace("revoke_", "")
                            subprocess.run(["flota", "bloquear", r_seal], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            send_telegram("sendMessage", {
                                "chat_id": authorized_chat,
                                "text": f"🔴 *ORDEN DE REVOCACIÓN Y BLOQUEO ENVIADA*\nSello: `{r_seal}`",
                                "parse_mode": "Markdown"
                            })

                        elif cb_data.startswith("auth_approve:") or cb_data.startswith("auth_approve_"):
                            if ":" in cb_data:
                                parts = cb_data.split(":")
                                a_seal = parts[1] if len(parts) > 1 else ""
                            else:
                                a_seal = cb_data.replace("auth_approve_", "")
                            send_telegram("editMessageText", {
                                "chat_id": authorized_chat,
                                "message_id": msg_id,
                                "text": f"✅ *DISPOSITIVO AUTORIZADO*\n━━━━━━━━━━━━━━━━━━━━━━━━━\n🏷️ *Sello:* `{a_seal}`\n⚡ Instalación aprobada desde Telegram.",
                                "parse_mode": "Markdown"
                            })

                        elif cb_data.startswith("auth_reject:") or cb_data.startswith("auth_reject_"):
                            if ":" in cb_data:
                                parts = cb_data.split(":")
                                r_seal = parts[1] if len(parts) > 1 else ""
                            else:
                                r_seal = cb_data.replace("auth_reject_", "")
                            send_telegram("editMessageText", {
                                "chat_id": authorized_chat,
                                "message_id": msg_id,
                                "text": f"❌ *ACCESO RECHAZADO*\n━━━━━━━━━━━━━━━━━━━━━━━━━\n🏷️ *Sello:* `{r_seal}`\n⛔ Solicitud denegada.",
                                "parse_mode": "Markdown"
                            })
                        continue

                    # 2. Manejo de Mensajes de Texto y Comandos
                    msg = item.get("message")
                    if not msg:
                        continue

                    sender_chat = str(msg.get("chat", {}).get("id"))
                    if sender_chat != authorized_chat:
                        continue

                    text = msg.get("text", "").strip()
                    if not text:
                        continue

                    if text.startswith("/sentinel_pause_"):
                        try:
                            pause_sec = int(text.split("_")[-1])
                        except Exception:
                            pause_sec = 45
                        print(f"[*] Pausando escucha por {pause_sec}s para autorización de dispositivo...")
                        time.sleep(pause_sec)
                        continue

                    if text.startswith("/"):
                        parts = text.split(maxsplit=1)
                        raw_cmd = parts[0]
                        cmd = raw_cmd.split("@")[0].lower()
                        args = parts[1] if len(parts) > 1 else ""
                        handle_telegram_command(cmd, args, msg, sender_chat)
                    elif text.startswith("#!"):
                        report = run_lsp_analysis(text)
                        send_telegram("sendMessage", {"chat_id": sender_chat, "text": report, "parse_mode": "Markdown"})

        except Exception as e:
            time.sleep(3)

# ==============================================================================
# SECCIÓN 5: Menú Oficial de Telegram (/setMyCommands)
# ==============================================================================

def set_bot_menu_commands():
    """Configura el catálogo oficial completo de comandos en Telegram."""
    token, _ = get_tg_creds()
    commands = [
        {"command": "comando", "description": "⚡ Ejecutar comando en celular, todos o en cola"},
        {"command": "bateria", "description": "🔋 Nivel de batería, carga y temperatura"},
        {"command": "flota", "description": "👑 Dashboard general de celulares y cuentas"},
        {"command": "build", "description": "🔨 Encolar compilación distribuida"},
        {"command": "lint", "description": "🔍 Análisis estático y LSP sin ejecución"},
        {"command": "sync_fleet", "description": "🚀 Sincronizar GitOps con firmas Ed25519"},
        {"command": "logs", "description": "🔐 Consultar registros cifrados en RAM"},
        {"command": "logs_export", "description": "📄 Exportar log como archivo adjunto"},
        {"command": "diagnostico", "description": "🩺 Autodiagnóstico de fallos con Gemini AI"},
        {"command": "doc", "description": "📖 Generar documentación técnica con IA"},
        {"command": "set_ai_key", "description": "🔑 Guardar API Key de Gemini cifrada"},
        {"command": "dispositivos", "description": "📱 Listar dispositivos vinculados"},
        {"command": "bloquear", "description": "🔴 Revocar acceso y ordenar borrado remoto"},
        {"command": "broadcast", "description": "📢 Difundir mensaje del Líder a la flota"},
        {"command": "respaldo", "description": "💾 Generar respaldo maestro ultra-cifrado"},
        {"command": "estado", "description": "🛡️ Telemetría y centinelas activos"},
        {"command": "ayuda", "description": "📖 Manual completo de uso del sistema"}
    ]
    url = f"https://api.telegram.org/bot{token}/setMyCommands"
    data = json.dumps({"commands": commands}).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode())
    except Exception as e:
        return {"ok": False, "error": str(e)}

# ==============================================================================
# SECCIÓN 6: Punto de Entrada CLI
# ==============================================================================

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Uso: cloud-sentinel [seal|auth-request|auth-poll|notify|notify-btn|send-doc|set-menu|daemon|lsp|diagnose|doc|set-ai-key]")
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "seal":
        print(get_hardware_seal())
    elif cmd == "auth-request":
        user = sys.argv[2] if len(sys.argv) > 2 else "Usuario"
        seal = sys.argv[3] if len(sys.argv) > 3 else get_hardware_seal()
        is_restore = sys.argv[4] == "1" if len(sys.argv) > 4 else False
        req_id, msg_id = send_auth_request(user, seal, is_restore)
        print(f"{req_id}|{msg_id}")
    elif cmd == "auth-poll":
        req_id = sys.argv[2]
        msg_id = sys.argv[3]
        user = sys.argv[4]
        seal = sys.argv[5]
        timeout = int(sys.argv[6]) if len(sys.argv) > 6 else 90
        res = poll_auth_response(req_id, msg_id, user, seal, timeout)
        if res is True:
            print("APPROVED")
            sys.exit(0)
        elif res is False:
            print("REJECTED")
            sys.exit(1)
        else:
            print("TIMEOUT")
            sys.exit(2)
    elif cmd == "notify":
        title = sys.argv[2] if len(sys.argv) > 2 else "Notificación"
        content = sys.argv[3] if len(sys.argv) > 3 else ""
        _, cid = get_tg_creds()
        send_telegram("sendMessage", {
            "chat_id": cid,
            "text": f"{title}\n━━━━━━━━━━━━━━━━━━━━━━━━━\n{content}",
            "parse_mode": "Markdown"
        })
    elif cmd == "notify-btn":
        title = sys.argv[2] if len(sys.argv) > 2 else "Notificación"
        content = sys.argv[3] if len(sys.argv) > 3 else ""
        markup_json = json.loads(sys.argv[4]) if len(sys.argv) > 4 else {}
        _, cid = get_tg_creds()
        send_telegram("sendMessage", {
            "chat_id": cid,
            "text": f"{title}\n━━━━━━━━━━━━━━━━━━━━━━━━━\n{content}",
            "parse_mode": "Markdown",
            "reply_markup": markup_json
        })
    elif cmd == "send-doc":
        if len(sys.argv) < 3:
            print("Uso: cloud-sentinel send-doc <file_path> [caption]")
            sys.exit(1)
        f_path = sys.argv[2]
        cap = sys.argv[3] if len(sys.argv) > 3 else ""
        _, cid = get_tg_creds()
        print(send_telegram_document(cid, f_path, cap))
    elif cmd == "set-menu":
        print(set_bot_menu_commands())
    elif cmd == "daemon":
        bot_daemon_loop()
    elif cmd == "lsp":
        if len(sys.argv) > 2:
            target = sys.argv[2]
            if os.path.isfile(target):
                with open(target, "r", encoding="utf-8", errors="replace") as f:
                    code = f.read()
                print(run_lsp_analysis(code, lang_hint=os.path.splitext(target)[1].replace(".", "")))
            else:
                print(run_lsp_analysis(target))
        else:
            code = sys.stdin.read()
            print(run_lsp_analysis(code))
    elif cmd == "diagnose":
        if len(sys.argv) < 3:
            print("Uso: cloud-sentinel diagnose <job_id>")
            sys.exit(1)
        print(ai_diagnose_job(sys.argv[2]))
    elif cmd == "doc":
        if len(sys.argv) < 3:
            print("Uso: cloud-sentinel doc <script_name>")
            sys.exit(1)
        print(ai_document_script(sys.argv[2]))
    elif cmd == "set-ai-key":
        if len(sys.argv) < 3:
            print("Uso: cloud-sentinel set-ai-key <api_key>")
            sys.exit(1)
        save_gemini_key(sys.argv[2])
        print("[✓] API Key de Gemini guardada y cifrada correctamente.")

#!/data/data/com.termux/files/usr/bin/bash
set -e

# ==============================================================================
# sync-vscode: Sincronización Automática e Incremental con Autenticación Silenciosa
# ==============================================================================

QUIET=0
if [ "$1" = "--quiet" ] || [ "$1" = "-q" ]; then
    QUIET=1
fi

# Purga proactiva de tokens heredados en disco (Zero Plaintext / Zero Disk Storage)
rm -f "$HOME/.config/termux-vscode/.auth_token" "$HOME/.config/termux-vscode/.auth_token.enc" 2>/dev/null || true

# 2. Localizar dinámicamente el repositorio del proyecto en cualquier dispositivo
REPO_DIR=""
CONFIG_FILE="$HOME/.config/termux-vscode/repo_path"
[ -f "$CONFIG_FILE" ] && REPO_DIR=$(cat "$CONFIG_FILE" 2>/dev/null || true)
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    REPO_DIR="$HOME/termux-vscode-x11"
fi

# 2.1 Limpiar bloqueos de Git huérfanos si hubo un cierre abrupto
if [ -f "$REPO_DIR/.git/index.lock" ]; then
    if ! pgrep -x "git" >/dev/null 2>&1; then
        rm -f "$REPO_DIR/.git/index.lock" 2>/dev/null || true
    fi
fi

# 3. Asegurar directorios de destino
mkdir -p "$REPO_DIR/credenciales"
mkdir -p "$REPO_DIR/config"
mkdir -p "$REPO_DIR/bin"

# 4. Sincronizar Bóveda Cifrada de la Identidad Activa (Cero Texto Plano)
ACTIVE_FILE="$HOME/.config/termux-vscode/active_identity"
ACTIVE_SEAL="ums9230-sp_6300-3724801c"
[ -f "$ACTIVE_FILE" ] && ACTIVE_SEAL=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "$ACTIVE_SEAL")

if [ -d "$REPO_DIR/credenciales/$ACTIVE_SEAL" ]; then
    VAULT_DIR="$REPO_DIR/credenciales/$ACTIVE_SEAL"
else
    MATCH=$(find "$REPO_DIR/credenciales" -maxdepth 1 -type d -name "*${ACTIVE_SEAL}" 2>/dev/null | head -n 1)
    if [ -n "$MATCH" ]; then
        VAULT_DIR="$MATCH"
    else
        VAULT_DIR="$REPO_DIR/credenciales/$ACTIVE_SEAL"
        mkdir -p "$VAULT_DIR"
    fi
fi
TARGET_SEAL=$(basename "$VAULT_DIR")

if command -v vault-manager >/dev/null 2>&1; then
    vault-manager pack "$TARGET_SEAL" "$VAULT_DIR/vault.enc"
elif [ -f "$REPO_DIR/bin/vault-manager" ]; then
    bash "$REPO_DIR/bin/vault-manager" pack "$TARGET_SEAL" "$VAULT_DIR/vault.enc"
else
    if [ -d "$HOME/.config/Code - OSS/User" ] || [ -d "$HOME/.config/zen" ]; then
        SESSION_KEY=$(github-auth-broker session-key "$TARGET_SEAL" 2>/dev/null || true)
        if [ -n "$SESSION_KEY" ]; then
            PASS_KEY="$SESSION_KEY"
        tar -czf - \
            --exclude="cache2" \
            --exclude="startupCache" \
            --exclude="lock" \
            --exclude=".parentlock" \
            --exclude="Crash Reports" \
            --exclude="minidumps" \
            --exclude="*.tmp" \
            --exclude="*.log" \
            --exclude="*.sock" \
            -C "$HOME/.config" "Code - OSS/User" "zen" 2>/dev/null | \
            PASS_KEY="$PASS_KEY" openssl enc -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass env:PASS_KEY -out "$VAULT_DIR/vault.enc" 2>/dev/null || true
            unset SESSION_KEY
        fi
    fi
fi

# 5. Sincronizar configuraciones visuales del sistema (solo si no están vacías)
[ -s "$HOME/.config/openbox/rc.xml" ] && cp "$HOME/.config/openbox/rc.xml" "$REPO_DIR/config/rc.xml" 2>/dev/null || true
[ -s "$HOME/.config/openbox/menu.xml" ] && cp "$HOME/.config/openbox/menu.xml" "$REPO_DIR/config/menu.xml" 2>/dev/null || true
[ -s "$HOME/.config/tint2/tint2rc" ] && cp "$HOME/.config/tint2/tint2rc" "$REPO_DIR/config/tint2rc" 2>/dev/null || true
[ -s "$HOME/.config/tint2/tint2rc_vertical" ] && cp "$HOME/.config/tint2/tint2rc_vertical" "$REPO_DIR/config/tint2rc_vertical" 2>/dev/null || true
[ -s "$HOME/.config/tint2/tint2rc_horizontal" ] && cp "$HOME/.config/tint2/tint2rc_horizontal" "$REPO_DIR/config/tint2rc_horizontal" 2>/dev/null || true
[ -s "$HOME/.config/Code - OSS/User/settings.json" ] && cp "$HOME/.config/Code - OSS/User/settings.json" "$REPO_DIR/config/settings.json" 2>/dev/null || true

# Auto-recuperación de tint2 si se encuentra corrupto o vacío en el sistema local
if [ ! -s "$HOME/.config/tint2/tint2rc_vertical" ] && [ -s "$REPO_DIR/config/tint2rc_vertical" ]; then
    mkdir -p "$HOME/.config/tint2"
    cp "$REPO_DIR/config/tint2rc_vertical" "$HOME/.config/tint2/tint2rc_vertical" 2>/dev/null || true
fi
if [ ! -s "$HOME/.config/tint2/tint2rc_horizontal" ] && [ -s "$REPO_DIR/config/tint2rc_horizontal" ]; then
    mkdir -p "$HOME/.config/tint2"
    cp "$REPO_DIR/config/tint2rc_horizontal" "$HOME/.config/tint2/tint2rc_horizontal" 2>/dev/null || true
fi
if [ ! -s "$HOME/.config/tint2/tint2rc" ] && [ -s "$REPO_DIR/config/tint2rc" ]; then
    mkdir -p "$HOME/.config/tint2"
    cp "$REPO_DIR/config/tint2rc" "$HOME/.config/tint2/tint2rc" 2>/dev/null || true
fi

# 6. Sincronizar scripts
SCRIPTS=(
    "encender"
    "apagar"
    "orientation-sentinel"
    "start-vscode"
    "stop-vscode"
    "share-port"
    "dev-info"
    "notify-done"
    "sync-vscode"
    "restore-vscode"
    "watcher-sync"
    "integrity-watchdog"
    "integrity-guard"
    "setup-swap"
    "set-marketplace"
    "fix-phantom-killer"
    "new-project"
    "start-vscode-web"
    "guia"
    "vscode"
    "toggle-touch-mode"
    "switch-identity"
    "cloud-sentinel"
    "flota"
    "termux-runner"
    "vault-logs"
    "gitops-sync"
    "desinstalar-vscode"
    "desinstalar"
    "fetch-app-icon"
    "code-stack-ascii"
    "github-auth-broker"
    "gpu-optimizer"
    "vault-manager"
)

for s in "${SCRIPTS[@]}"; do
    [ -f "$PREFIX/bin/$s" ] && cp "$PREFIX/bin/$s" "$REPO_DIR/bin/$s" 2>/dev/null || true
done

# 7. Sellar firma de integridad criptográfica (Ed25519)
if command -v integrity-guard >/dev/null 2>&1; then
    integrity-guard sign "$REPO_DIR" >/dev/null 2>&1 || true
fi

# 7.1 Sincronización a Cloudflare Edge Gateway (R2 Vault)
GATEWAY_URL=""
[ -f "$HOME/.config/termux-vscode/gateway_url" ] && GATEWAY_URL=$(cat "$HOME/.config/termux-vscode/gateway_url" 2>/dev/null | tr -d '[:space:]')
if [ -n "$GATEWAY_URL" ] && [ -f "$VAULT_DIR/vault.enc" ]; then
    curl -s -X POST -H "X-Device-Seal: $ACTIVE_SEAL" --data-binary @"$VAULT_DIR/vault.enc" "$GATEWAY_URL/api/v1/vault/upload?seal=$ACTIVE_SEAL" >/dev/null 2>&1 || true
fi

# 8. Regla de Oro: Solo el Líder puede hacer commits y push a GitHub
LOCAL_SEAL=$(cat "$HOME/.config/termux-vscode/.device_hw_seal" 2>/dev/null || github-auth-broker seal 2>/dev/null || echo "")
if [ "$LOCAL_SEAL" = "ums9230-sp_6300-3724801c" ]; then
    cd "$REPO_DIR"

    CHANGES=$(git status --porcelain 2>/dev/null || true)
    UNPUSHED=$(git log origin/main..HEAD --oneline 2>/dev/null || true)

    if [ -n "$CHANGES" ]; then
        git add -A 2>/dev/null || true
        COMMIT_MSG="sync: actualización de datos ($(date '+%Y-%m-%d %H:%M:%S'))"
        git commit -S -m "$COMMIT_MSG" >/dev/null 2>&1 || \
        git commit -m "$COMMIT_MSG" >/dev/null 2>&1 || true
        UNPUSHED="1"
    fi

    # Subida a GitHub exclusiva del Líder con validación efímera (MS)
    if [ -n "$UNPUSHED" ]; then
        if ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1 || curl -sI --connect-timeout 2 https://1.1.1.1 >/dev/null 2>&1; then
            GIT_ASKPASS="github-auth-broker" timeout 45 git push origin main >/dev/null 2>&1 || true
            git update-ref refs/remotes/origin/main "$(git rev-parse HEAD 2>/dev/null)" 2>/dev/null || true
        fi
    fi
fi

[ "$QUIET" -eq 0 ] && echo "Listo."

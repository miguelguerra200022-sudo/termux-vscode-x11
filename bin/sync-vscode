#!/data/data/com.termux/files/usr/bin/bash
set -e

# ==============================================================================
# sync-vscode: Sincronización Automática e Incremental con Autenticación Silenciosa
# ==============================================================================

AUTH_FILE="$HOME/.config/termux-vscode/.auth_token"
HASH_SEGURA="8b8aba3300315db216e0e9050522d4952881e67273687b00caff2a78cf958315"
ENC_TOKEN="U2FsdGVkX18HMNx1lAWR1MyfdAoYnNpD3BJrndGiPR3X0TDQp/wmnqKZO/8JzgvJVHTG9QIS6HP4WVVcCONKsg=="

QUIET=0
if [ "$1" = "--quiet" ] || [ "$1" = "-q" ]; then
    QUIET=1
fi

TOKEN=""
AUTH_ENC="$HOME/.config/termux-vscode/.auth_token.enc"
MACHINE_KEY=$(echo -n "$(id -u)_$(uname -m)_termux_vault" | sha256sum | awk '{print $1}')

if [ -f "$AUTH_ENC" ]; then
    TOKEN=$(openssl enc -d -aes-256-cbc -a -A -pbkdf2 -in "$AUTH_ENC" -pass pass:"$MACHINE_KEY" 2>/dev/null || true)
elif [ -f "$AUTH_FILE" ]; then
    TOKEN=$(cat "$AUTH_FILE" 2>/dev/null || true)
    if [ -n "$TOKEN" ]; then
        echo -n "$TOKEN" | openssl enc -aes-256-cbc -a -A -pbkdf2 -pass pass:"$MACHINE_KEY" > "$AUTH_ENC" 2>/dev/null || true
        chmod 400 "$AUTH_ENC" 2>/dev/null || true
        rm -f "$AUTH_FILE" 2>/dev/null || true
    fi
fi

# 1. Si no hay token guardado previamente, solicitar contraseña una única vez
if [ -z "$TOKEN" ]; then
    USER_PASS="${SYNC_PASS:-}"
    if [ -z "$USER_PASS" ]; then
        if [ -t 0 ]; then
            echo -ne "🔒 Contraseña: "
            read -s USER_PASS
            echo ""
        else
            read -r USER_PASS || true
        fi
    fi

    INPUT_HASH=$(echo -n "$USER_PASS" | sha256sum | awk '{print $1}')
    if [ "$INPUT_HASH" != "$HASH_SEGURA" ]; then
        [ "$QUIET" -eq 0 ] && echo "[!] Contraseña incorrecta."
        exit 1
    fi

    TOKEN=$(echo "$ENC_TOKEN" | openssl enc -d -aes-256-cbc -a -A -pbkdf2 -pass pass:"$USER_PASS" 2>/dev/null || true)
    if [ -n "$TOKEN" ]; then
        mkdir -p "$HOME/.config/termux-vscode"
        echo -n "$TOKEN" | openssl enc -aes-256-cbc -a -A -pbkdf2 -pass pass:"$MACHINE_KEY" > "$AUTH_ENC" 2>/dev/null || true
        chmod 400 "$AUTH_ENC" 2>/dev/null || true
        rm -f "$AUTH_FILE" 2>/dev/null || true
    fi
fi

# 2. Localizar el repositorio del proyecto
REPO_DIR=""
POSSIBLE_PATHS=(
    "/storage/emulated/0/Antigravity/IdeasMillonarias/termux-vscode-x11"
    "$HOME/termux-vscode-x11"
    "/storage/emulated/0/Antigravity/termux-vscode-x11"
)

for dir in "${POSSIBLE_PATHS[@]}"; do
    if [ -d "$dir/.git" ]; then
        REPO_DIR="$dir"
        break
    fi
done

if [ -z "$REPO_DIR" ]; then
    REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi

if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    exit 0
fi

# 2.1 Limpiar bloqueos de Git huérfanos si hubo un cierre abrupto
if [ -f "$REPO_DIR/.git/index.lock" ]; then
    if ! pgrep -x "git" >/dev/null 2>&1; then
        rm -f "$REPO_DIR/.git/index.lock" 2>/dev/null || true
    fi
fi

# 3. Asegurar directorios de destino
mkdir -p "$REPO_DIR/data/vscode/User"
mkdir -p "$REPO_DIR/data/zen"
mkdir -p "$REPO_DIR/config"
mkdir -p "$REPO_DIR/bin"

# 4. Sincronizar VS Code (User data, estado y configuraciones)
if [ -d "$HOME/.config/Code - OSS/User" ]; then
    rsync -rltD --no-perms --no-owner --no-group --delete \
        --exclude=".git" \
        --exclude="checkpoints" \
        --exclude="*.log" \
        --exclude="*.tmp" \
        --exclude="*.sock" \
        --exclude="*.cpuprofile" \
        --exclude="*.heapsnapshot" \
        "$HOME/.config/Code - OSS/User/" "$REPO_DIR/data/vscode/User/" 2>/dev/null || true
fi

[ -f "$HOME/.vscode-oss/argv.json" ] && cp "$HOME/.vscode-oss/argv.json" "$REPO_DIR/data/vscode/argv.json" 2>/dev/null || true

# 5. Sincronizar Zen Browser (perfiles, historial, cookies, SQLite WAL/SHM y sesiones)
if [ -d "$HOME/.config/zen" ]; then
    rsync -rltD --no-perms --no-owner --no-group --delete \
        --exclude="cache2" \
        --exclude="startupCache" \
        --exclude="lock" \
        --exclude=".parentlock" \
        --exclude="*.tmp" \
        --exclude="*.log" \
        --exclude="Crash Reports" \
        --exclude="minidumps" \
        "$HOME/.config/zen/" "$REPO_DIR/data/zen/" 2>/dev/null || true
fi

# 6. Sincronizar configuraciones visuales
[ -f "$HOME/.config/openbox/rc.xml" ] && cp "$HOME/.config/openbox/rc.xml" "$REPO_DIR/config/rc.xml" 2>/dev/null || true
[ -f "$HOME/.config/openbox/menu.xml" ] && cp "$HOME/.config/openbox/menu.xml" "$REPO_DIR/config/menu.xml" 2>/dev/null || true
[ -f "$HOME/.config/tint2/tint2rc" ] && cp "$HOME/.config/tint2/tint2rc" "$REPO_DIR/config/tint2rc" 2>/dev/null || true
[ -f "$HOME/.config/Code - OSS/User/settings.json" ] && cp "$HOME/.config/Code - OSS/User/settings.json" "$REPO_DIR/config/settings.json" 2>/dev/null || true

# 7. Sincronizar scripts
SCRIPTS=(
    "start-vscode"
    "stop-vscode"
    "share-port"
    "dev-info"
    "notify-done"
    "sync-vscode"
    "restore-vscode"
    "watcher-sync"
    "integrity-watchdog"
    "integrity-guard"
    "setup-swap"
    "set-marketplace"
    "fix-phantom-killer"
    "new-project"
    "start-vscode-web"
    "guia"
    "vscode"
)

for s in "${SCRIPTS[@]}"; do
    [ -f "$PREFIX/bin/$s" ] && cp "$PREFIX/bin/$s" "$REPO_DIR/bin/$s" 2>/dev/null || true
done

# 8. Sellar firma de integridad criptográfica
if command -v integrity-guard >/dev/null 2>&1; then
    integrity-guard sign "$REPO_DIR" >/dev/null 2>&1 || true
fi

# 9. Detectar cambios en Git y subir incrementalmente
cd "$REPO_DIR"

CHANGES=$(git status --porcelain 2>/dev/null || true)
UNPUSHED=$(git log origin/main..HEAD --oneline 2>/dev/null || true)

if [ -n "$CHANGES" ]; then
    git add -A 2>/dev/null || true
    COMMIT_MSG="sync: actualización de datos ($(date '+%Y-%m-%d %H:%M:%S'))"
    git commit -S -m "$COMMIT_MSG" >/dev/null 2>&1 || \
    git commit -m "$COMMIT_MSG" >/dev/null 2>&1 || true
    UNPUSHED="1"
fi

# 10. Subida a GitHub con token en memoria RAM
if [ -n "$UNPUSHED" ]; then
    if ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1 || curl -sI --connect-timeout 2 https://1.1.1.1 >/dev/null 2>&1; then
        if [ -n "$TOKEN" ]; then
            REMOTE_B64="aHR0cHM6Ly9taWd1ZWxndWVycmEyMDAwMjItc3Vkbzoke1RPS0VOfUBnaXRodWIuY29tL21pZ3VlbGd1ZXJyYTIwMDAyMi1zdWRvL3Rlcm11eC12c2NvZGUteDExLmdpdA=="
            TARGET_PUSH=$(echo "$REMOTE_B64" | base64 -d | sed "s/\${TOKEN}/$TOKEN/")
            timeout 30 git push "$TARGET_PUSH" main >/dev/null 2>&1 || true
        else
            timeout 30 git push origin main >/dev/null 2>&1 || true
        fi
    fi
fi

[ "$QUIET" -eq 0 ] && echo "Listo."

#!/data/data/com.termux/files/usr/bin/bash
set -e
# ==============================================================================
# sync-vscode: Sincroniza y respalda tus configuraciones a GitHub en un solo clic
# ==============================================================================

REPO_DIR="/storage/emulated/0/Antigravity/IdeasMillonarias/termux-vscode-x11"

if [ ! -d "$REPO_DIR/.git" ]; then
    echo -e "\033[0;31m[!] Error: No se encontró el repositorio en $REPO_DIR\033[0m"
    exit 1
fi

echo -e "\033[0;34m[*] Copiando configuraciones locales al repositorio...\033[0m"

# Copiar configuraciones actuales
mkdir -p "$REPO_DIR/config" "$REPO_DIR/bin"
[ -f "$HOME/.config/Code - OSS/User/settings.json" ] && cp "$HOME/.config/Code - OSS/User/settings.json" "$REPO_DIR/config/settings.json"
[ -f "$HOME/.vscode-oss/argv.json" ] && cp "$HOME/.vscode-oss/argv.json" "$REPO_DIR/config/argv.json"
[ -f "$HOME/.config/openbox/rc.xml" ] && cp "$HOME/.config/openbox/rc.xml" "$REPO_DIR/config/rc.xml"

for script in start-vscode stop-vscode share-port dev-info notify-done sync-vscode setup-swap; do
    [ -f "$PREFIX/bin/$script" ] && cp "$PREFIX/bin/$script" "$REPO_DIR/bin/$script"
done

cd "$REPO_DIR"

if [ -z "$(git status --porcelain)" ]; then
    echo -e "\033[0;32m[+] Todo está actualizado. No hay cambios pendientes por subir.\033[0m"
    exit 0
fi

echo -e "\033[1;33m[*] Subiendo cambios a GitHub (miguelguerra200022-sudo/termux-vscode-x11)...\033[0m"
git add .
git commit -m "sync: actualización automática de configuraciones $(date '+%Y-%m-%d %H:%M:%S')"
git push origin main

echo -e "\033[0;32m[+] ¡Configuraciones respaldadas con éxito en GitHub!\033[0m"

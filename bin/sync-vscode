#!/data/data/com.termux/files/usr/bin/bash
set -e

# ==============================================================================
# sync-vscode: Sincronización Automática e Incremental con Autenticación Segura
# ==============================================================================
# - Verificación por contraseña (hash SHA-256 criptográfico).
# - Modo sigiloso (no expone URLs ni tokens en pantalla).
# - Almacenamiento 100% privado en Termux (sin residuos en /storage/emulated/0).
# ==============================================================================

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

HASH_SEGURA="1e875d6311ef243cebac22b61d5fa9fa4bd57ef94db3e8079879b2002ba7ae8a"

# 1. Autenticación con contraseña protegida
if [ -t 0 ]; then
    echo -ne "${CYAN}🔒 Ingrese contraseña de seguridad para sincronizar:${NC} "
    read -s USER_PASS
    echo ""
else
    read -r USER_PASS || true
fi

INPUT_HASH=$(echo -n "$USER_PASS" | sha256sum | awk '{print $1}')
if [ "$INPUT_HASH" != "$HASH_SEGURA" ]; then
    echo -e "${RED}[!] Contraseña incorrecta. Operación cancelada.${NC}"
    exit 1
fi

# 2. Localizar el repositorio del proyecto
REPO_DIR=""
POSSIBLE_PATHS=(
    "/storage/emulated/0/Antigravity/IdeasMillonarias/termux-vscode-x11"
    "$HOME/termux-vscode-x11"
    "/storage/emulated/0/Antigravity/termux-vscode-x11"
)

for dir in "${POSSIBLE_PATHS[@]}"; do
    if [ -d "$dir/.git" ]; then
        REPO_DIR="$dir"
        break
    fi
done

if [ -z "$REPO_DIR" ]; then
    REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi

if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
    exit 0
fi

echo -e "${CYAN}[*] Sincronizando datos de forma segura...${NC}"

# 3. Asegurar directorios de destino
mkdir -p "$REPO_DIR/data/vscode/User"
mkdir -p "$REPO_DIR/data/zen"
mkdir -p "$REPO_DIR/config"
mkdir -p "$REPO_DIR/bin"

# 4. Sincronizar VS Code (User data, estado y configuraciones)
if [ -d "$HOME/.config/Code - OSS/User" ]; then
    rsync -rltD --no-perms --no-owner --no-group --delete \
        --exclude=".git" \
        --exclude="checkpoints" \
        --exclude="*.log" \
        --exclude="*.tmp" \
        --exclude="*.sock" \
        --exclude="*.cpuprofile" \
        --exclude="*.heapsnapshot" \
        "$HOME/.config/Code - OSS/User/" "$REPO_DIR/data/vscode/User/" 2>/dev/null || true
fi

[ -f "$HOME/.vscode-oss/argv.json" ] && cp "$HOME/.vscode-oss/argv.json" "$REPO_DIR/data/vscode/argv.json" 2>/dev/null || true

# 5. Sincronizar Zen Browser (perfiles, historial, cookies, contraseñas y sesiones)
if [ -d "$HOME/.config/zen" ]; then
    rsync -rltD --no-perms --no-owner --no-group --delete \
        --exclude="cache2" \
        --exclude="startupCache" \
        --exclude="lock" \
        --exclude=".parentlock" \
        --exclude="*.tmp" \
        --exclude="*.log" \
        --exclude="Crash Reports" \
        --exclude="minidumps" \
        "$HOME/.config/zen/" "$REPO_DIR/data/zen/" 2>/dev/null || true
fi

# 6. Sincronizar configuraciones visuales
[ -f "$HOME/.config/openbox/rc.xml" ] && cp "$HOME/.config/openbox/rc.xml" "$REPO_DIR/config/rc.xml" 2>/dev/null || true
[ -f "$HOME/.config/openbox/menu.xml" ] && cp "$HOME/.config/openbox/menu.xml" "$REPO_DIR/config/menu.xml" 2>/dev/null || true
[ -f "$HOME/.config/tint2/tint2rc" ] && cp "$HOME/.config/tint2/tint2rc" "$REPO_DIR/config/tint2rc" 2>/dev/null || true
[ -f "$HOME/.config/Code - OSS/User/settings.json" ] && cp "$HOME/.config/Code - OSS/User/settings.json" "$REPO_DIR/config/settings.json" 2>/dev/null || true

# 7. Sincronizar scripts
SCRIPTS=(
    "start-vscode"
    "stop-vscode"
    "share-port"
    "dev-info"
    "notify-done"
    "sync-vscode"
    "restore-vscode"
    "setup-swap"
    "set-marketplace"
    "fix-phantom-killer"
    "new-project"
    "start-vscode-web"
    "guia"
    "vscode"
)

for s in "${SCRIPTS[@]}"; do
    [ -f "$PREFIX/bin/$s" ] && cp "$PREFIX/bin/$s" "$REPO_DIR/bin/$s" 2>/dev/null || true
done

# 8. Detectar cambios en Git y subir incrementalmente
cd "$REPO_DIR"

CHANGES=$(git status --porcelain data/ config/ bin/ docs/ 2>/dev/null || true)

if [ -z "$CHANGES" ]; then
    echo -e "${GREEN}[✓] Datos al día (sin cambios nuevos).${NC}"
    exit 0
fi

git add data/ config/ bin/ docs/ install.sh 2>/dev/null || true
COMMIT_MSG="sync: actualización de datos ($(date '+%Y-%m-%d %H:%M:%S'))"
git commit -m "$COMMIT_MSG" >/dev/null 2>&1 || true

if timeout 30 git push origin main >/dev/null 2>&1; then
    echo -e "${GREEN}[✓] Sesión y datos sincronizados correctamente.${NC}"
else
    echo -e "${YELLOW}[!] Guardado localmente. Se sincronizará en la próxima conexión.${NC}"
fi
